<UserControl
    x:Class="RemoteFlow.UI.Views.Storage.FileBrowserPane"
    x:DataType="viewModels:FileBrowserPaneViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:RemoteFlow.UI.ViewModels.Storage"
    xmlns:storage="using:RemoteFlow.Application.Abstractions.Storage">
  <Border Classes="panel" ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
      <!-- Where you are and how to move, in reading order. -->
      <Grid Margin="8,6,8,0" ColumnDefinitions="Auto,Auto,*,Auto">
        <!-- Only shown when there is a choice to make: one drive, or a bucket, is not a picker. -->
        <ComboBox
            AutomationProperties.Name="{Binding RootsLabel}"
            Margin="0,0,6,0"
            MinWidth="120"
            IsVisible="{Binding HasRoots}"
            ItemsSource="{Binding Roots}"
            SelectedItem="{Binding SelectedRoot}"
            ToolTip.Tip="{Binding RootsLabel}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="storage:FileBrowserCrumb">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <Button
              AutomationProperties.Name="{Binding BackLabel}"
              Classes="icon"
              Command="{Binding BackCommand}"
              IsEnabled="{Binding CanGoBack}"
              ToolTip.Tip="{Binding BackLabel}">
            <PathIcon Data="{DynamicResource Icon.Back}" />
          </Button>
          <Button
              AutomationProperties.Name="{Binding ForwardLabel}"
              Classes="icon"
              Command="{Binding ForwardCommand}"
              IsEnabled="{Binding CanGoForward}"
              ToolTip.Tip="{Binding ForwardLabel}">
            <PathIcon Data="{DynamicResource Icon.Forward}" />
          </Button>
          <Button
              AutomationProperties.Name="{Binding UpLabel}"
              Classes="icon"
              Command="{Binding UpCommand}"
              ToolTip.Tip="{Binding UpLabel}">
            <PathIcon Data="{DynamicResource Icon.Up}" />
          </Button>
          <Button
              AutomationProperties.Name="{Binding RefreshLabel}"
              Classes="icon"
              Command="{Binding RefreshCommand}"
              ToolTip.Tip="{Binding RefreshLabel}">
            <PathIcon Data="{DynamicResource Icon.Refresh}" />
          </Button>
        </StackPanel>
        <TextBox
            x:Name="PathEditor"
            Grid.Column="2"
            AutomationProperties.Name="{Binding PathLabel}"
            Margin="8,0"
            KeyDown="PathEditor_OnKeyDown"
            Text="{Binding PathText}" />
        <CheckBox
            Grid.Column="3"
            AutomationProperties.Name="{Binding HiddenLabel}"
            Content="Hidden"
            IsChecked="{Binding ShowHiddenEntries}"
            IsVisible="{Binding SupportsHiddenEntries}" />
      </Grid>

      <Grid Grid.Row="1" Margin="8,6,8,0" ColumnDefinitions="*,Auto">
        <ItemsControl ClipToBounds="True" ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="storage:FileBrowserCrumb">
              <StackPanel Orientation="Horizontal">
                <Button Classes="flat" Content="{Binding Label}" Click="Breadcrumb_OnClick" />
                <TextBlock Margin="2,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Muted}" Text="›" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button AutomationProperties.Name="{Binding NewFolderLabel}" Click="NewFolder_OnClick" ToolTip.Tip="{Binding NewFolderLabel}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="14" Height="14" Data="{DynamicResource Icon.NewFolder}" />
              <TextBlock Text="New folder" />
            </StackPanel>
          </Button>
          <!-- Transfer lives on the pane it starts from, not in a centre column of arrows: those steal
               width at every window size and land awkwardly in tab order between two lists. -->
          <Button
              AutomationProperties.Name="{Binding TransferAccessibleLabel}"
              Classes="accent"
              Command="{Binding TransferCommand}"
              ToolTip.Tip="{Binding TransferAccessibleLabel}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="14" Height="14" Data="{DynamicResource Icon.Transfers}" />
              <TextBlock Text="{Binding TransferLabel}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="2" Margin="8,6,8,0" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsCreatingFolder}">
        <TextBox
            x:Name="NewFolderEditor"
            AutomationProperties.Name="{Binding NewFolderNameLabel}"
            Width="220"
            KeyDown="NewFolderEditor_OnKeyDown"
            Text="{Binding NewFolderName}" />
        <Button Classes="accent" Content="Create" Click="CreateFolder_OnClick" />
        <Button Content="Cancel" Click="CancelCreateFolder_OnClick" />
      </StackPanel>

      <Border
          Grid.Row="3"
          Margin="8,6,8,0"
          Padding="10,6"
          Background="{DynamicResource Brush.Danger.Surface}"
          BorderBrush="{DynamicResource Brush.Danger}"
          BorderThickness="1"
          CornerRadius="{DynamicResource Radius.Control}"
          IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
      </Border>

      <Grid Grid.Row="4" Margin="0,6,0,0" RowDefinitions="Auto,*">
        <Border Classes="browser-header">
          <Grid ColumnDefinitions="3*,90,130">
            <Button
                AutomationProperties.Name="{Binding SortNameLabel}"
                Classes="flat column"
                HorizontalContentAlignment="Left"
                Padding="20,2,8,2"
                Click="SortName_OnClick"
                ToolTip.Tip="{Binding SortScopeTooltip}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Name" />
                <TextBlock Classes="sort" Text="{Binding NameSortGlyph}" />
              </StackPanel>
            </Button>
            <Button
                Grid.Column="1"
                AutomationProperties.Name="{Binding SortSizeLabel}"
                Classes="flat column"
                HorizontalContentAlignment="Right"
                Click="SortSize_OnClick"
                ToolTip.Tip="{Binding SortScopeTooltip}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Size" />
                <TextBlock Classes="sort" Text="{Binding SizeSortGlyph}" />
              </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                AutomationProperties.Name="{Binding SortModifiedLabel}"
                Classes="flat column"
                HorizontalContentAlignment="Left"
                Padding="12,2,8,2"
                Click="SortModified_OnClick"
                ToolTip.Tip="{Binding SortScopeTooltip}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Modified" />
                <TextBlock Classes="sort" Text="{Binding ModifiedSortGlyph}" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <ListBox
            x:Name="EntryList"
            Grid.Row="1"
            AutomationProperties.Name="{Binding ListLabel}"
            Classes="browser"
            Background="Transparent"
            Focusable="True"
            SelectionMode="Multiple"
            ItemsSource="{Binding Items}"
            SelectionChanged="EntryList_OnSelectionChanged"
            DoubleTapped="EntryList_OnDoubleTapped"
            KeyDown="EntryList_OnKeyDown"
            TextInput="EntryList_OnTextInput"
            PointerPressed="EntryList_OnPointerPressed"
            DragDrop.AllowDrop="True"
            DragDrop.DragOver="EntryList_OnDragOver"
            DragDrop.DragLeave="EntryList_OnDragLeave"
            DragDrop.Drop="EntryList_OnDrop">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="viewModels:FileBrowserItemViewModel">
              <!-- The transparent background is what makes the gaps between the columns hit-testable, so
                   the context menu opens anywhere on the row rather than only over the name. -->
              <Grid ColumnDefinitions="3*,90,130" MinHeight="24" Background="Transparent">
                <Grid ColumnDefinitions="20,*">
                  <PathIcon
                      Width="13"
                      Height="13"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Data="{DynamicResource Icon.Folder}"
                      Foreground="{DynamicResource Brush.Accent}"
                      IsVisible="{Binding IsDirectory}" />
                  <PathIcon
                      Width="13"
                      Height="13"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Data="{DynamicResource Icon.File}"
                      Foreground="{DynamicResource Brush.Text.Secondary}"
                      IsVisible="{Binding !IsDirectory}" />
                  <Grid Grid.Column="1">
                    <TextBlock VerticalAlignment="Center" IsVisible="{Binding !IsRenaming}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBox
                        AutomationProperties.Name="Rename"
                        IsVisible="{Binding IsRenaming}"
                        KeyDown="RenameEditor_OnKeyDown"
                        Text="{Binding RenameText}" />
                  </Grid>
                </Grid>
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding SizeText}" />
                <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding ModifiedText}" TextTrimming="CharacterEllipsis" />
                <Grid.ContextFlyout>
                  <MenuFlyout>
                    <MenuItem Header="Open" Click="Open_OnClick" />
                    <!-- "Upload" on the local pane and "Download" on the remote one, carried on the row:
                         a flyout is a popup, so $parent does not reach the pane from in here. -->
                    <MenuItem Header="{Binding TransferLabel}" Click="Transfer_OnClick" />
                    <Separator />
                    <MenuItem Header="Rename" Click="Rename_OnClick" />
                    <MenuItem Header="Delete…" Click="Delete_OnClick" />
                    <Separator />
                    <MenuItem Header="Copy path" Click="CopyPath_OnClick" />
                  </MenuFlyout>
                </Grid.ContextFlyout>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- The cap and the filter. A truncated listing never claims a total: S3 cannot cheaply count a
           prefix, so it says "of many" instead of inventing a number. -->
      <Grid Grid.Row="5" Margin="8,6,8,6" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock
            VerticalAlignment="Center"
            Foreground="{DynamicResource Brush.Warning}"
            IsVisible="{Binding IsTruncated}"
            Text="{Binding TruncationMessage}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <Button
            Grid.Column="1"
            AutomationProperties.Name="{Binding LoadMoreLabel}"
            Command="{Binding LoadMoreCommand}"
            Content="Load more"
            IsVisible="{Binding HasMore}" />
        <TextBox
            Grid.Column="2"
            AutomationProperties.Name="{Binding FilterLabel}"
            MinWidth="180"
            Text="{Binding FilterText}"
            Watermark="Starts with…" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
