<UserControl
    x:Class="RemoteFlow.UI.Views.Connections.ConnectionsView"
    x:DataType="connectionViewModels:ConnectionsPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:connectionViewModels="using:RemoteFlow.UI.ViewModels.Connections"
    xmlns:connectionViews="using:RemoteFlow.UI.Views.Connections"
    Loaded="ConnectionsView_OnLoaded"
    Unloaded="ConnectionsView_OnUnloaded">
  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type connectionViewModels:ConnectionEditorViewModel}" x:DataType="connectionViewModels:ConnectionEditorViewModel">
      <connectionViews:ConnectionEditorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type connectionViewModels:ConnectionDetailsViewModel}" x:DataType="connectionViewModels:ConnectionDetailsViewModel">
      <connectionViews:ConnectionDetailsView />
    </DataTemplate>
  </UserControl.DataTemplates>
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Connections" />
        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Favorites, recent sessions, and all saved connections" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Click="NewFolder_OnClick" Content="New folder" ToolTip.Tip="Create a top-level folder. Right-click a folder to add one inside it." />
        <Button Click="ClearRecent_OnClick" Content="Clear recent" />
      </StackPanel>
    </Grid>

    <connectionViews:SearchBar Grid.Row="1" Margin="0,0,0,12" />

    <Border
        Grid.Row="2"
        Margin="0,0,0,8"
        Padding="10,6"
        Background="{DynamicResource Brush.Surface.2}"
        CornerRadius="{DynamicResource Radius.Control}"
        IsVisible="{Binding FeedbackMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Foreground="{DynamicResource Brush.Warning}" Text="{Binding FeedbackMessage}" />
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="2*,3*" ColumnSpacing="16">
      <TreeView
          x:Name="ConnectionTree"
          DragDrop.AllowDrop="True"
          ItemsSource="{Binding RootNodes}"
          DragDrop.DragOver="ConnectionTree_OnDragOver"
          DragDrop.Drop="ConnectionTree_OnDrop"
          KeyDown="ConnectionTree_OnKeyDown"
          DoubleTapped="ConnectionTree_OnDoubleTapped"
          SelectionChanged="ConnectionTree_OnSelectionChanged"
          SelectionMode="Multiple">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </TreeView.ItemsPanel>
        <TreeView.DataTemplates>
          <TreeDataTemplate
              DataType="{x:Type connectionViewModels:ExplorerNodeViewModel}"
              ItemsSource="{Binding Children}"
              x:DataType="connectionViewModels:ExplorerNodeViewModel">
            <Grid ColumnDefinitions="24,Auto,Auto,*" Margin="2" PointerPressed="Node_OnPointerPressed">
              <TextBlock VerticalAlignment="Center" Text="{Binding Icon}" />
              <Grid Grid.Column="1" VerticalAlignment="Center">
                <TextBlock IsVisible="{Binding !IsRenaming}" Text="{Binding Name}" />
                <TextBox
                    x:Name="InlineRenameBox"
                    IsVisible="{Binding IsRenaming}"
                    KeyDown="InlineRename_OnKeyDown"
                    MinWidth="140"
                    Text="{Binding EditName}" />
              </Grid>
              <Border
                  Grid.Column="2"
                  Margin="8,0"
                  Padding="6,2"
                  Background="{Binding Badge.Background}"
                  CornerRadius="4"
                  IsVisible="{Binding Badge, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock FontWeight="Bold" Text="{Binding Badge.Icon}" />
                  <TextBlock FontSize="11" FontWeight="Bold" Text="{Binding Badge.Text}" />
                </StackPanel>
              </Border>
              <TextBlock
                  Grid.Column="3"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource Brush.Text.Secondary}"
                  Text="{Binding SecondaryText}" />
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Command="{Binding ConnectCommand}" Header="Connect" />
                  <MenuItem Command="{Binding OpenSftpCommand}" Header="Open SFTP" />
                  <MenuItem Command="{Binding OpenRdpCommand}" Header="Launch RDP" />
                  <Separator />
                  <MenuItem Command="{Binding EditCommand}" Header="Edit" />
                  <MenuItem Command="{Binding DuplicateCommand}" Header="Duplicate" />
                  <MenuItem Command="{Binding DeleteCommand}" Header="Delete" />
                  <Separator />
                  <MenuItem Command="{Binding NewFolderCommand}" Header="New subfolder" />
                  <MenuItem Command="{Binding BeginRenameCommand}" Header="Rename (F2)" />
                </ContextMenu>
              </Grid.ContextMenu>
            </Grid>
          </TreeDataTemplate>
        </TreeView.DataTemplates>
      </TreeView>

      <Border
          Grid.Column="0"
          Padding="40"
          Background="{DynamicResource Brush.Surface.1}"
          CornerRadius="{DynamicResource Radius.Control}"
          IsVisible="{Binding IsEmpty}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <TextBlock FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{Binding EmptyStateTitle}" />
          <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding EmptyStateMessage}" />
          <Button
              Click="CreateFirstConnection_OnClick"
              Content="Create connection"
              HorizontalAlignment="Center"
              IsVisible="{Binding !HasActiveFilters}" />
          <Button
              Click="ClearFilters_OnClick"
              Content="Clear filters"
              HorizontalAlignment="Center"
              IsVisible="{Binding HasActiveFilters}" />
        </StackPanel>
      </Border>

      <ContentControl Grid.Column="1" Content="{Binding Details}" IsVisible="{Binding !IsEditorOpen}" />
      <ContentControl Grid.Column="1" Content="{Binding Editor}" IsVisible="{Binding IsEditorOpen}" />
    </Grid>
  </Grid>
</UserControl>
