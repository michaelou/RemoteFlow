<UserControl
    x:Class="RemoteFlow.UI.Views.Connections.ConnectionsView"
    x:DataType="connectionViewModels:ConnectionsPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:connectionViewModels="using:RemoteFlow.UI.ViewModels.Connections"
    xmlns:connectionViews="using:RemoteFlow.UI.Views.Connections"
    xmlns:converters="using:RemoteFlow.UI.Converters"
    Loaded="ConnectionsView_OnLoaded"
    Unloaded="ConnectionsView_OnUnloaded">
  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type connectionViewModels:ConnectionEditorViewModel}" x:DataType="connectionViewModels:ConnectionEditorViewModel">
      <connectionViews:ConnectionEditorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type connectionViewModels:ConnectionDetailsViewModel}" x:DataType="connectionViewModels:ConnectionDetailsViewModel">
      <connectionViews:ConnectionDetailsView />
    </DataTemplate>
  </UserControl.DataTemplates>
  <UserControl.Styles>
    <!-- The filter menu is a stack of sections, and each one needs a quieter word above its choices than
         the choices themselves. -->
    <Style Selector="TextBlock.filter-section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
  </UserControl.Styles>
  <!-- The page carries the name of the item selected in the sidebar and the list says what it holds, so a
       heading here would only repeat one of them. The search and the actions go in a card instead: it is
       the one band of controls on the page, and it should read as one thing. -->
  <Grid Margin="8" RowDefinitions="Auto,Auto,*">
    <Border Classes="panel" Margin="0,0,0,8" Padding="12">
      <StackPanel Spacing="10">
        <TextBox
            x:Name="SearchTextBox"
            AutomationProperties.Name="Search connections"
            PlaceholderText="Search name, host, user, notes, or tags"
            Text="{Binding SearchText, Mode=TwoWay}" />
        <Grid ColumnDefinitions="Auto,*,Auto">
          <!-- One worded button for what the page is for, and glyphs for the rest: they are the four
               things done to the list rather than to a connection, and words for all of them crowded out
               the search box above them. Every glyph button names itself twice — a tooltip for the pointer
               and an automation name for a screen reader — because an unlabelled icon is a guess. -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Click="CreateConnection_OnClick" Content="New connection" />
            <Button
                AutomationProperties.Name="New folder"
                Classes="icon"
                Click="NewFolder_OnClick"
                ToolTip.Tip="Create a top-level folder. Right-click a folder to add one inside it.">
              <PathIcon Data="{DynamicResource Icon.NewFolder}" />
            </Button>
            <Button
                AutomationProperties.Name="Clear recent"
                Classes="icon"
                Click="ClearRecent_OnClick"
                ToolTip.Tip="Empty the Recent list">
              <PathIcon Data="{DynamicResource Icon.ClearRecent}" />
            </Button>
            <!-- One button, not two: it closes the folders while any are open and opens them again once
                 they are all shut, and its glyph and its tooltip both say which. -->
            <Button
                AutomationProperties.Name="{Binding ExpandCollapseLabel}"
                Classes="icon"
                Click="ToggleFolders_OnClick"
                IsEnabled="{Binding HasFolders}"
                ToolTip.Tip="{Binding ExpandCollapseLabel}">
              <PathIcon Data="{Binding ExpandCollapseIconKey, Converter={x:Static converters:ResourceKeyConverter.Instance}}" />
            </Button>
            <Button
                AutomationProperties.Name="{Binding SecondaryTextLabel}"
                Classes="icon"
                Click="ToggleSecondaryText_OnClick"
                ToolTip.Tip="{Binding SecondaryTextLabel}">
              <PathIcon Data="{Binding SecondaryTextIconKey, Converter={x:Static converters:ResourceKeyConverter.Instance}}" />
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <!-- Protocol, environment and tags used to sit on the page as three rows of checkboxes, which
                 cost more room than the list they filter. They live behind this button now; the summary and
                 the way out of them travel with them, so the whole state of the filter is in one place. -->
            <Button Content="Filters" ToolTip.Tip="Filter by protocol, environment, or tag">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel MinWidth="220" MaxWidth="320" Spacing="12">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="filter-section" Text="Protocol" />
                      <ItemsControl ItemsSource="{Binding ProtocolFilters}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="connectionViewModels:ConnectionFilterChipViewModel">
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <TextBlock Classes="filter-section" Text="Environment" />
                      <ItemsControl ItemsSource="{Binding EnvironmentFilters}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="connectionViewModels:ConnectionFilterChipViewModel">
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <TextBlock Classes="filter-section" Text="Tags" />
                      <ItemsControl ItemsSource="{Binding TagFilters}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="connectionViewModels:ConnectionFilterChipViewModel">
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <CheckBox Content="Favorites only" IsChecked="{Binding FavoritesOnly, Mode=TwoWay}" />

                    <TextBlock
                        Foreground="{DynamicResource Brush.Text.Secondary}"
                        IsVisible="{Binding HasActiveFilters}"
                        Text="{Binding ActiveFilterSummary}"
                        TextWrapping="Wrap" />
                    <Button
                        Click="ClearAll_OnClick"
                        Content="Clear all filters"
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding HasActiveFilters}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border
        Grid.Row="1"
        Margin="0,0,0,8"
        Padding="10,6"
        Background="{DynamicResource Brush.Surface.2}"
        CornerRadius="{DynamicResource Radius.Control}"
        IsVisible="{Binding FeedbackMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Foreground="{DynamicResource Brush.Warning}" Text="{Binding FeedbackMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button
            Command="{Binding RunFeedbackActionCommand}"
            Content="{Binding FeedbackActionLabel}"
            IsVisible="{Binding FeedbackActionLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <!-- The pane's column is sized by what is in it rather than pinned at 500, and the gap between the two
         is the pane's own margin rather than the grid's spacing. Both so that closing the pane leaves the
         list the full width of the page instead of a 500-pixel hole and an 8-pixel gutter beside it. -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <!-- Both halves of the page sit on their own card, so the tree and whatever is open beside it read
           as two panels rather than as content poured straight onto the window. -->
      <!-- No horizontal padding, and clipped: the rows run to the card's edges so the rules between them
           read as one list rather than as a stack of separate strips, and the card's own corners cut them. -->
      <Border Classes="panel" ClipToBounds="True" Padding="0,8" IsVisible="{Binding !IsEmpty}">
        <TreeView
            x:Name="ConnectionTree"
            Background="Transparent"
            BorderThickness="0"
            Classes="explorer"
            Classes.compact="{Binding !ShowSecondaryText}"
            DragDrop.AllowDrop="True"
            ItemsSource="{Binding RootNodes}"
            DragDrop.DragOver="ConnectionTree_OnDragOver"
            DragDrop.Drop="ConnectionTree_OnDrop"
            KeyDown="ConnectionTree_OnKeyDown"
            DoubleTapped="ConnectionTree_OnDoubleTapped"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectionChanged="ConnectionTree_OnSelectionChanged"
            SelectionMode="Multiple">
          <TreeView.Resources>
            <!-- Fluent indents a level by 16. The rows already carry a fixed icon gutter, so a narrower step
                 is enough to show depth without pushing deep names off the card. -->
            <x:Double x:Key="TreeViewItemIndent">14</x:Double>
          </TreeView.Resources>
          <!-- Every selector below is prefixed with the tree's own class. A bare "TreeViewItem /template/" rule
               is weaker than the values the control template itself set, so it would silently do nothing; the
               class turns the selector into a trigger, which outranks both the template and Fluent's own state
               styles. The rules are scoped to this tree rather than to Controls.axaml because this is the only
               TreeView in the application, and a list of hosts is not the same thing as a generic tree. -->
          <TreeView.Styles>
            <Style Selector="TreeViewItem">
              <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
            </Style>

            <!-- The row's own border is the rule between it and the row below. PART_LayoutRoot wraps the header
                 and not the subtree, and the per-level indent lives on the header inside it, so one setter here
                 draws exactly one full-width line per row at every depth. The corners have to go: a border on
                 one edge only takes the rounded-geometry path, which would curl the line away from both ends. -->
            <Style Selector="TreeView.explorer TreeViewItem">
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
              <Setter Property="BorderThickness" Value="0,0,0,1" />
              <Setter Property="CornerRadius" Value="0" />
              <Setter Property="MinHeight" Value="40" />
              <Setter Property="Padding" Value="0,6" />
            </Style>

            <!-- With the host line off, a row holds one line of text, and the height a two-line row needs
                 becomes air. The class is on the tree rather than on each row because the toolbar's toggle
                 is a decision about the whole list, and the tree is the control whose data context knows
                 about it. -->
            <Style Selector="TreeView.explorer.compact TreeViewItem">
              <Setter Property="MinHeight" Value="0" />
              <Setter Property="Padding" Value="0,4" />
            </Style>

            <!-- Fluent reserves 36px for the chevron whether or not a node has children. That is the gutter that
                 sets where every name begins, and at 36 it leaves the icons stranded from the text. -->
            <Style Selector="TreeView.explorer TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
              <Setter Property="Margin" Value="4,0,6,0" />
              <Setter Property="Width" Value="12" />
            </Style>

            <!-- Fluent paints the row's states straight onto PART_LayoutRoot, at a strength that beats the
                 border set above, so each state has to name the rule's colour again or the line changes shade
                 as the pointer moves down the list. The selected fill is Fluent's accent by default; on this
                 surface it reads as a foreign blue, so it takes the same raised surface the sidebar uses.
                 The pointerover sits on the border rather than on the item: a child row is a visual descendant
                 of its parent, so hovering a host would otherwise light up every folder above it. -->
            <Style Selector="TreeView.explorer TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
              <Setter Property="Background" Value="{DynamicResource Brush.Surface.2}" />
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            </Style>
            <Style Selector="TreeView.explorer TreeViewItem:pressed /template/ Border#PART_LayoutRoot:pointerover">
              <Setter Property="Background" Value="{DynamicResource Brush.Surface.2}" />
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            </Style>
            <Style Selector="TreeView.explorer TreeViewItem:selected /template/ Border#PART_LayoutRoot">
              <Setter Property="Background" Value="{DynamicResource Brush.Surface.2}" />
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            </Style>
            <Style Selector="TreeView.explorer TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
              <Setter Property="Background" Value="{DynamicResource Brush.Surface.2}" />
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            </Style>
            <Style Selector="TreeView.explorer TreeViewItem:pressed:selected /template/ Border#PART_LayoutRoot:pointerover">
              <Setter Property="Background" Value="{DynamicResource Brush.Surface.2}" />
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            </Style>
            <!-- Hover and selection both raise the row to the same surface, so the fill alone cannot say which
                 row the details beside the list belong to. The name and its glyph carry the accent instead:
                 it survives the pointer moving away, and it is the one foreground already measured against
                 this surface. The host and the badge set their own colours and stay put. -->
            <Style Selector="TreeView.explorer TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </Style>

            <!-- Controls.axaml marks keyboard focus by thickening this border to two pixels on all four sides.
                 Against a one-pixel rule on one side that grows the row and shoves its content sideways on every
                 arrow key. The thickness is pinned back here and focus is carried by the fill and the adorner
                 the template already draws around this part, so the row stays exactly where it was. -->
            <Style Selector="TreeView.explorer TreeViewItem:focus-visible /template/ Border#PART_LayoutRoot">
              <Setter Property="Background" Value="{DynamicResource Brush.Surface.2}" />
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
              <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>

            <!-- One hue per protocol, matched on the tag the row carries. Dynamic resources rather than a
                 brush built in the view model: these are the one part of a row that has to change when the
                 window switches between light and dark, and a brush handed over by a converter would stay
                 the colour it was built as. The glyph is only half of the signal — the shape differs too —
                 so nothing here is the sole carrier of what a row is. -->
            <Style Selector="TreeView.explorer PathIcon[Tag=ssh]">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Protocol.Ssh}" />
            </Style>
            <Style Selector="TreeView.explorer PathIcon[Tag=sftp]">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Protocol.Sftp}" />
            </Style>
            <Style Selector="TreeView.explorer PathIcon[Tag=rdp]">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Protocol.Rdp}" />
            </Style>
            <Style Selector="TreeView.explorer PathIcon[Tag=s3]">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Protocol.S3}" />
            </Style>
            <Style Selector="TreeView.explorer PathIcon[Tag=azure-blob]">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Protocol.AzureBlob}" />
            </Style>

            <!-- The environment chip, coloured the same way and for the same reason: one fill per
                 environment, named by the tag the row carries, so PROD is sorted from STAGE from DEV before
                 a word is read — and so both the fill and the ink on it follow a light-dark switch. The
                 word inside the chip stays the thing that actually says which environment; the colour only
                 finds it faster. The ink is the environment's own colour, the same one the swatch beside the
                 Environment picker shows, so the two can never disagree about what green means. -->
            <Style Selector="TreeView.explorer Border.env-chip[Tag=prod]">
              <Setter Property="Background" Value="{DynamicResource Brush.Badge.Prod.Background}" />
            </Style>
            <Style Selector="TreeView.explorer Border.env-chip[Tag=prod] TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Prod.Text}" />
            </Style>
            <Style Selector="TreeView.explorer Border.env-chip[Tag=stage]">
              <Setter Property="Background" Value="{DynamicResource Brush.Badge.Stage.Background}" />
            </Style>
            <Style Selector="TreeView.explorer Border.env-chip[Tag=stage] TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Stage.Text}" />
            </Style>
            <Style Selector="TreeView.explorer Border.env-chip[Tag=dev]">
              <Setter Property="Background" Value="{DynamicResource Brush.Badge.Dev.Background}" />
            </Style>
            <Style Selector="TreeView.explorer Border.env-chip[Tag=dev] TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Dev.Text}" />
            </Style>
            <!-- A connection with no environment but a colour of its own still earns a chip, because the
                 colour would otherwise be the whole message on its session tab. It gets the neutral badge
                 palette: the chip says which environment, and this one has none to say. -->
            <Style Selector="TreeView.explorer Border.env-chip[Tag=custom]">
              <Setter Property="Background" Value="{DynamicResource Brush.Badge.Background}" />
            </Style>
            <Style Selector="TreeView.explorer Border.env-chip[Tag=custom] TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Text}" />
            </Style>

            <!-- Favorites and Recent are headings for the rows underneath them, not rows in their own right. -->
            <Style Selector="TreeView.explorer Grid.group TextBlock">
              <Setter Property="FontSize" Value="11" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            </Style>
            <Style Selector="TreeView.explorer Grid.group PathIcon">
              <Setter Property="Width" Value="13" />
              <Setter Property="Height" Value="13" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            </Style>
          </TreeView.Styles>
          <TreeView.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </TreeView.ItemsPanel>
          <TreeView.DataTemplates>
            <TreeDataTemplate
                DataType="{x:Type connectionViewModels:ExplorerNodeViewModel}"
                ItemsSource="{Binding Children}"
                x:DataType="connectionViewModels:ExplorerNodeViewModel">
              <!-- A fixed glyph in a spaced column rather than a wider one the glyph floats inside, so the
                   names line up down the list on the same edge the sidebar's own labels use. -->
              <!-- The transparent background is what makes the whole line hit-testable: a panel with no
                   background of its own is skipped by hit testing, so the right-click menu and the drag only
                   answered over the glyph, the name, and the badge, with dead air in between. -->
              <Grid
                  Background="Transparent"
                  Classes.group="{Binding IsVirtual}"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10"
                  PointerPressed="Node_OnPointerPressed">
                <!-- The tag is what the protocol colour rules above select on. A node that is not a
                     connection carries none, so no rule matches it and its glyph goes on inheriting the
                     row's foreground — which is what turns a selected folder's glyph with its name. -->
                <PathIcon
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Data="{Binding IconKey, Converter={x:Static converters:ResourceKeyConverter.Instance}}"
                    Tag="{Binding ProtocolTag}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <Grid>
                    <TextBlock IsVisible="{Binding !IsRenaming}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBox
                        x:Name="InlineRenameBox"
                        AutomationProperties.Name="Rename"
                        IsVisible="{Binding IsRenaming}"
                        KeyDown="InlineRename_OnKeyDown"
                        MinWidth="140"
                        Text="{Binding EditName}" />
                  </Grid>
                  <!-- Two nested visibilities rather than one expression: the panel answers the toolbar's
                       show-and-hide for the whole list, and the line inside it answers whether this row has
                       a host to show at all. A collapsed panel takes no height, so hiding the line closes
                       the row up instead of leaving a gap where it was. -->
                  <Panel IsVisible="{Binding $parent[UserControl].((connectionViewModels:ConnectionsPageViewModel)DataContext).ShowSecondaryText}">
                    <TextBlock
                        FontSize="11"
                        Margin="0,1,0,0"
                        Foreground="{DynamicResource Brush.Text.Muted}"
                        IsVisible="{Binding SecondaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Text="{Binding SecondaryText}"
                        TextTrimming="CharacterEllipsis" />
                  </Panel>
                </StackPanel>
                <!-- Held at the row's right edge rather than trailing the host name, so the badges form their
                     own column instead of starting at a different place on every row. -->
                <Border
                    Grid.Column="2"
                    Classes="env-chip"
                    Margin="0,0,10,0"
                    Padding="5,1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    CornerRadius="{DynamicResource Radius.Small}"
                    IsVisible="{Binding Badge, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Tag="{Binding Badge.Tag}">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock FontSize="9" FontWeight="Bold" Text="{Binding Badge.Icon}" />
                    <TextBlock FontSize="9" FontWeight="Bold" Text="{Binding Badge.Text}" />
                  </StackPanel>
                </Border>
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Command="{Binding ConnectCommand}" Header="Connect" />
                    <MenuItem Command="{Binding OpenSftpCommand}" Header="Open SFTP" />
                    <MenuItem Command="{Binding OpenRdpCommand}" Header="Launch RDP" />
                    <Separator />
                    <MenuItem Command="{Binding EditCommand}" Header="Edit" />
                    <MenuItem Command="{Binding DuplicateCommand}" Header="Duplicate" />
                    <MenuItem Command="{Binding DeleteCommand}" Header="Delete" />
                    <Separator />
                    <MenuItem Command="{Binding NewFolderCommand}" Header="New subfolder" />
                    <MenuItem Command="{Binding BeginRenameCommand}" Header="Rename (F2)" />
                  </ContextMenu>
                </Grid.ContextMenu>
              </Grid>
            </TreeDataTemplate>
          </TreeView.DataTemplates>
        </TreeView>
      </Border>

      <Border Classes="panel" Grid.Column="0" Padding="40" IsVisible="{Binding IsEmpty}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <TextBlock FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{Binding EmptyStateTitle}" />
          <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding EmptyStateMessage}" />
          <Button
              Click="CreateConnection_OnClick"
              Content="Create connection"
              HorizontalAlignment="Center"
              IsVisible="{Binding !HasActiveFilters}" />
          <Button
              Click="ClearFilters_OnClick"
              Content="Clear filters"
              HorizontalAlignment="Center"
              IsVisible="{Binding HasActiveFilters}" />
        </StackPanel>
      </Border>

      <Panel
          Grid.Column="1"
          Width="500"
          Margin="8,0,0,0"
          IsVisible="{Binding IsWorkspaceOpen}">
        <ContentControl Content="{Binding Details}" IsVisible="{Binding !IsEditorOpen}" />
        <ContentControl Content="{Binding Editor}" IsVisible="{Binding IsEditorOpen}" />
      </Panel>
    </Grid>
  </Grid>
</UserControl>
