<UserControl
    x:Class="RemoteFlow.UI.Views.Connections.ConnectionDetailsView"
    x:DataType="connectionViewModels:ConnectionDetailsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:connectionViewModels="using:RemoteFlow.UI.ViewModels.Connections">
  <Border Padding="20" Background="{DynamicResource Brush.Surface.1}" CornerRadius="8">
    <ScrollViewer>
      <StackPanel Spacing="12">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Name}" />
        <WrapPanel>
          <Button Margin="0,0,8,8" Command="{Binding ConnectCommand}" Content="Connect" />
          <Button Margin="0,0,8,8" Command="{Binding OpenSftpCommand}" Content="Open SFTP" />
          <Button Margin="0,0,8,8" Command="{Binding LaunchRdpCommand}" Content="Launch RDP" />
          <Button Margin="0,0,8,8" Command="{Binding OpenSystemTerminalCommand}" Content="Open in system terminal" />
          <Button AutomationProperties.Name="Edit connection" Margin="0,0,8,8" Command="{Binding EditCommand}" ToolTip.Tip="Edit">
            <PathIcon Width="16" Height="16" Data="{DynamicResource Icon.Edit}" />
          </Button>
          <Button AutomationProperties.Name="Duplicate connection" Margin="0,0,8,8" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate">
            <PathIcon Width="16" Height="16" Data="{DynamicResource Icon.Duplicate}" />
          </Button>
          <Button AutomationProperties.Name="Delete connection" Margin="0,0,8,8" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete">
            <PathIcon Width="16" Height="16" Data="{DynamicResource Icon.Delete}" />
          </Button>
        </WrapPanel>
        <TextBlock
            Foreground="{DynamicResource Brush.Warning}"
            IsVisible="{Binding ExternalLaunchMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Text="{Binding ExternalLaunchMessage}"
            TextWrapping="Wrap" />
        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
          <TextBlock FontWeight="SemiBold" Text="Host" /><TextBlock Grid.Column="1" Text="{Binding HostAndPort}" />
          <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Protocol" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Protocol}" />
          <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Authentication" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Authentication}" />
          <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Environment" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Environment}" />
          <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Tags" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TagsText}" />
          <TextBlock Grid.Row="5" FontWeight="SemiBold" Text="Folder" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding FolderPath}" />
          <TextBlock Grid.Row="6" FontWeight="SemiBold" Text="Last connected" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastConnectedText}" />
          <TextBlock Grid.Row="7" FontWeight="SemiBold" Text="Notes" /><TextBlock Grid.Row="7" Grid.Column="1" TextWrapping="Wrap" Text="{Binding Notes}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
