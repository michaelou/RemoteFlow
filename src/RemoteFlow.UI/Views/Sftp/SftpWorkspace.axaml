<UserControl
    x:Class="RemoteFlow.UI.Views.Sftp.SftpWorkspace"
    x:DataType="viewModels:SftpWorkspaceViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:RemoteFlow.UI.ViewModels.Sftp"
    Loaded="Workspace_OnLoaded">
  <Grid RowDefinitions="*,Auto">
  <Grid Margin="20,20,20,10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
    <!-- Connection picker: the workspace can be opened straight from here, not only by connecting
         from the explorer. -->
    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,10">
      <TextBlock
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          Foreground="{DynamicResource Brush.Text.Secondary}"
          Text="Connection" />
      <ComboBox
          x:Name="ConnectionPicker"
          Grid.Column="1"
          HorizontalAlignment="Stretch"
          ItemsSource="{Binding AvailableConnections}"
          SelectedItem="{Binding SelectedConnection}"
          PlaceholderText="Select a connection…">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="viewModels:SftpConnectionChoice">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Name}" />
              <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding Endpoint}" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button
          Grid.Column="2"
          Margin="8,0,0,0"
          Classes="accent"
          Content="Connect"
          Command="{Binding ConnectSelectedCommand}" />
      <Button
          Grid.Column="3"
          Margin="6,0,0,0"
          Content="↻"
          Command="{Binding LoadConnectionsCommand}"
          ToolTip.Tip="Reload the connection list" />
      <TextBlock
          Grid.Column="4"
          Margin="12,0,0,0"
          VerticalAlignment="Center"
          FontWeight="SemiBold"
          IsVisible="{Binding IsConnected}"
          Text="{Binding ConnectionTitle}" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsConnected}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="←" IsEnabled="{Binding CanGoBack}" Command="{Binding BackCommand}" ToolTip.Tip="Back" />
        <Button Content="→" IsEnabled="{Binding CanGoForward}" Command="{Binding ForwardCommand}" ToolTip.Tip="Forward" />
        <Button Content="↑" Command="{Binding UpCommand}" ToolTip.Tip="Up" />
        <Button Content="↻" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh" />
      </StackPanel>
      <TextBox
          x:Name="PathEditor"
          Grid.Column="1"
          Margin="10,0"
          Text="{Binding PathText}"
          KeyDown="PathEditor_OnKeyDown"
          PlaceholderText="/absolute/remote/path" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <CheckBox Content="Hidden files" IsChecked="{Binding ShowHiddenFiles}" />
        <Button Content="New folder" Click="NewFolder_OnClick" />
        <Button Content="Current permissions…" Click="CurrentPermissions_OnClick" />
        <Button Content="Upload…" Command="{Binding ChooseAndUploadCommand}" />
        <Button Content="Download…" Command="{Binding ChooseAndDownloadCommand}" />
        <Button Content="Cancel operation" IsVisible="{Binding IsMutating}" Command="{Binding CancelOperationCommand}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" Margin="0,10,0,6" ColumnDefinitions="*,Auto" IsVisible="{Binding IsConnected}">
      <ItemsControl ItemsSource="{Binding Breadcrumbs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="viewModels:SftpBreadcrumb">
            <StackPanel Orientation="Horizontal">
              <Button Classes="flat" Content="{Binding Label}" Click="Breadcrumb_OnClick" />
              <TextBlock Margin="3,0" VerticalAlignment="Center" Text="/" Foreground="{DynamicResource Brush.Text.Secondary}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsCreatingFolder}">
        <TextBox x:Name="NewFolderEditor" Width="220" Text="{Binding NewFolderName}" KeyDown="NewFolderEditor_OnKeyDown" />
        <Button Content="Create" Click="CreateFolder_OnClick" />
        <Button Content="Cancel" Click="CancelCreateFolder_OnClick" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="3" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Padding="10" Background="#33D43B3B">
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
    </Border>

    <Grid Grid.Row="4" ColumnDefinitions="3*,110,180,120,160" Margin="0,8,0,0" IsVisible="{Binding IsConnected}">
      <Button Classes="flat" HorizontalContentAlignment="Left" Content="Name" Click="SortName_OnClick" />
      <Button Grid.Column="1" Classes="flat" HorizontalContentAlignment="Right" Content="Size" Click="SortSize_OnClick" />
      <Button Grid.Column="2" Classes="flat" HorizontalContentAlignment="Left" Content="Modified" Click="SortModified_OnClick" />
      <Button Grid.Column="3" Classes="flat" HorizontalContentAlignment="Left" Content="Permissions" Click="SortPermissions_OnClick" />
      <Button Grid.Column="4" Classes="flat" HorizontalContentAlignment="Left" Content="Owner" Click="SortOwner_OnClick" />
    </Grid>

    <ListBox
        x:Name="FileList"
        Grid.Row="5"
        IsVisible="{Binding IsConnected}"
        SelectionMode="Multiple"
        ItemsSource="{Binding Items}"
        SelectionChanged="FileList_OnSelectionChanged"
        DoubleTapped="FileList_OnDoubleTapped"
        KeyDown="FileList_OnKeyDown"
        TextInput="FileList_OnTextInput"
        PointerPressed="FileList_OnPointerPressed"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="FileList_OnDragOver"
        DragDrop.DragLeave="FileList_OnDragLeave"
        DragDrop.Drop="FileList_OnDrop">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="viewModels:SftpItemViewModel">
          <!-- The transparent background is what makes the gaps between the columns hit-testable, so
               the context menu opens anywhere on the row rather than only over the file name. -->
          <Grid ColumnDefinitions="3*,110,180,120,160" MinHeight="30" Background="Transparent">
            <Grid>
              <TextBlock VerticalAlignment="Center" IsVisible="{Binding !IsRenaming}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBox IsVisible="{Binding IsRenaming}" Text="{Binding RenameText}" KeyDown="RenameEditor_OnKeyDown" />
            </Grid>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding SizeText}" />
            <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Modified, StringFormat={}{0:g}}" />
            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" Text="{Binding Permissions}" />
            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding Owner}" TextTrimming="CharacterEllipsis" />
            <Grid.ContextFlyout>
              <MenuFlyout>
                <MenuItem Header="Edit remotely" Click="EditRemote_OnClick" />
                <MenuItem Header="Stop remote editing" Click="StopRemoteEdit_OnClick" />
                <Separator />
                <MenuItem Header="Rename" Click="Rename_OnClick" />
                <MenuItem Header="Delete…" Click="Delete_OnClick" />
                <Separator />
                <MenuItem Header="Properties" Click="Properties_OnClick" />
                <MenuItem Header="Permissions…" Click="Permissions_OnClick" />
                <MenuItem Header="Copy shell-safe path" Click="CopyPath_OnClick" />
              </MenuFlyout>
            </Grid.ContextFlyout>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border
        Grid.Row="5"
        Margin="0,8,0,0"
        Padding="40"
        Background="{DynamicResource Brush.Surface.1}"
        CornerRadius="{DynamicResource Radius.Control}"
        IsVisible="{Binding !IsConnected}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Not connected" />
        <TextBlock
            HorizontalAlignment="Center"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Foreground="{DynamicResource Brush.Text.Secondary}"
            Text="{Binding NoConnectionMessage}" />
        <Button
            Classes="accent"
            Content="Connect"
            HorizontalAlignment="Center"
            IsVisible="{Binding HasConnectionChoices}"
            Command="{Binding ConnectSelectedCommand}" />
      </StackPanel>
    </Border>

  </Grid>

    <!-- Status bar: every slot keeps its space whether or not it has content, so the pane above
         never reflows and the indicators never overlap each other. -->
    <Border
        Grid.Row="1"
        Height="32"
        Padding="12,0"
        Background="{DynamicResource Brush.Surface.1}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="150,*,Auto,Auto">
        <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center"
            IsVisible="{Binding IsBusyIndicatorVisible}">
          <ProgressBar Width="60" Height="4" MinWidth="60" MinHeight="4" IsIndeterminate="True" VerticalAlignment="Center" />
          <TextBlock Text="Loading…" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>
        <TextBlock
            Grid.Column="1"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
            Text="{Binding FeedbackMessage}"
            Foreground="{DynamicResource Brush.Text.Secondary}" />
        <TextBlock
            Grid.Column="2"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            IsVisible="{Binding HasActiveRemoteEdits}"
            Text="{Binding RemoteEditIndicator}"
            FontWeight="SemiBold" />
        <TextBlock
            Grid.Column="3"
            VerticalAlignment="Center"
            IsVisible="{Binding DropTargetMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Text="{Binding DropTargetMessage}"
            FontWeight="SemiBold" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
