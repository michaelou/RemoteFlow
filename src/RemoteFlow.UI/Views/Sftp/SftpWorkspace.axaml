<UserControl
    x:Class="RemoteFlow.UI.Views.Sftp.SftpWorkspace"
    x:DataType="viewModels:SftpWorkspaceViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:RemoteFlow.UI.ViewModels.Sftp"
    xmlns:storage="using:RemoteFlow.UI.Views.Storage"
    Loaded="Workspace_OnLoaded"
    KeyDown="Workspace_OnKeyDown">
  <Grid RowDefinitions="*,Auto">
  <!-- Local filesystem on the left, the server on the right, the shared transfer queue along the bottom —
       the Storage page's shape, so the two pages are one thing to learn. The transfer row is a fixed pixel
       height rather than Auto: a GridSplitter needs a pixel or star neighbour or it is simply inert. -->
  <Grid Margin="8" RowDefinitions="Auto,*,6,180">
    <!-- Connection picker: the workspace can be opened straight from here, not only by connecting
         from the explorer. -->
    <Border Classes="panel" Margin="0,0,0,10" Padding="12,10">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <TextBlock
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Foreground="{DynamicResource Brush.Text.Secondary}"
            Text="Connection" />
        <ComboBox
            x:Name="ConnectionPicker"
            Grid.Column="1"
            AutomationProperties.Name="Connection"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding AvailableConnections}"
            SelectedItem="{Binding SelectedConnection}"
            PlaceholderText="Select a connection…">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="viewModels:SftpConnectionChoice">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding Endpoint}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button
            Grid.Column="2"
            Margin="8,0,0,0"
            Classes="accent"
            Content="Connect"
            Command="{Binding ConnectSelectedCommand}" />
        <Button
            Grid.Column="3"
            AutomationProperties.Name="Reload the connection list"
            Classes="icon"
            Margin="6,0,0,0"
            Command="{Binding LoadConnectionsCommand}"
            ToolTip.Tip="Reload the connection list">
          <PathIcon Data="{DynamicResource Icon.Refresh}" />
        </Button>
        <TextBlock
            Grid.Column="4"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            IsVisible="{Binding IsConnected}"
            Text="{Binding ConnectionTitle}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,6,*">
      <storage:FileBrowserPane x:Name="LocalPane" DataContext="{Binding Local}" />
      <!-- Named, and with help text, because a keyboard user can move a splitter with the arrow keys once
           it has focus — and would otherwise hear nothing but "splitter". -->
      <GridSplitter
          Grid.Column="1"
          AutomationProperties.Name="Width of the local and remote panes"
          AutomationProperties.HelpText="Use the left and right arrow keys to move the divider."
          Background="Transparent"
          ResizeDirection="Columns" />

      <!-- The remote listing mirrors the local pane row for row: one card, the same gutters, the same
           heading strip. The two sit side by side, and a heading a few pixels off from the one next to it
           reads as a broken table rather than as two panes. -->
      <Border Grid.Column="2" Classes="panel" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
          <!-- Where you are and how to move, in reading order. -->
          <Grid Margin="8,6,8,0" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsConnected}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button AutomationProperties.Name="Back" Classes="icon" IsEnabled="{Binding CanGoBack}" Command="{Binding BackCommand}" ToolTip.Tip="Back">
                <PathIcon Data="{DynamicResource Icon.Back}" />
              </Button>
              <Button AutomationProperties.Name="Forward" Classes="icon" IsEnabled="{Binding CanGoForward}" Command="{Binding ForwardCommand}" ToolTip.Tip="Forward">
                <PathIcon Data="{DynamicResource Icon.Forward}" />
              </Button>
              <Button AutomationProperties.Name="Up one folder" Classes="icon" Command="{Binding UpCommand}" ToolTip.Tip="Up">
                <PathIcon Data="{DynamicResource Icon.Up}" />
              </Button>
              <Button AutomationProperties.Name="Refresh this folder" Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh">
                <PathIcon Data="{DynamicResource Icon.Refresh}" />
              </Button>
            </StackPanel>
            <TextBox
                x:Name="PathEditor"
                Grid.Column="1"
                AutomationProperties.Name="Remote path"
                Margin="8,0"
                Text="{Binding PathText}"
                KeyDown="PathEditor_OnKeyDown"
                PlaceholderText="/absolute/remote/path" />
            <CheckBox
                Grid.Column="2"
                AutomationProperties.Name="Show hidden files"
                Content="Hidden"
                IsChecked="{Binding ShowHiddenFiles}" />
          </Grid>

          <Grid Grid.Row="1" Margin="8,6,8,0" ColumnDefinitions="*,Auto" IsVisible="{Binding IsConnected}">
            <ItemsControl ClipToBounds="True" ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:SftpBreadcrumb">
                  <StackPanel Orientation="Horizontal">
                    <Button Classes="flat" Content="{Binding Label}" Click="Breadcrumb_OnClick" />
                    <TextBlock Margin="2,0" VerticalAlignment="Center" Text="/" Foreground="{DynamicResource Brush.Text.Muted}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button AutomationProperties.Name="New folder" Click="NewFolder_OnClick" ToolTip.Tip="Create a folder here">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="14" Height="14" Data="{DynamicResource Icon.NewFolder}" />
                  <TextBlock Text="New folder" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.Name="Current permissions" Click="CurrentPermissions_OnClick" ToolTip.Tip="Permissions of the folder being shown">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="14" Height="14" Data="{DynamicResource Icon.Permissions}" />
                  <TextBlock Text="Permissions…" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.Name="Upload" Command="{Binding ChooseAndUploadCommand}" ToolTip.Tip="Upload files into this folder">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="14" Height="14" Data="{DynamicResource Icon.Upload}" />
                  <TextBlock Text="Upload…" />
                </StackPanel>
              </Button>
              <!-- Download to the local pane, and Download… to a folder you pick. The first is the dual-pane
                   gesture; the second is the one that predates the pane and still reaches anywhere. -->
              <Button
                  AutomationProperties.Name="Download the selection to the local pane"
                  Classes="accent"
                  Command="{Binding DownloadSelectionCommand}"
                  ToolTip.Tip="Download the selected items into the folder the local pane is showing">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="14" Height="14" Data="{DynamicResource Icon.Download}" />
                  <TextBlock Text="Download" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.Name="Download to a folder you choose" Command="{Binding ChooseAndDownloadCommand}" ToolTip.Tip="Download the selected items into a folder you choose">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="14" Height="14" Data="{DynamicResource Icon.Download}" />
                  <TextBlock Text="Download…" />
                </StackPanel>
              </Button>
              <Button
                  AutomationProperties.Name="Cancel operation"
                  Command="{Binding CancelOperationCommand}"
                  IsVisible="{Binding IsMutating}"
                  ToolTip.Tip="Cancel the operation in progress">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="14" Height="14" Data="{DynamicResource Icon.Cancel}" />
                  <TextBlock Text="Cancel" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="2" Margin="8,6,8,0" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsCreatingFolder}">
            <TextBox
                x:Name="NewFolderEditor"
                AutomationProperties.Name="New folder name"
                Width="220"
                Text="{Binding NewFolderName}"
                KeyDown="NewFolderEditor_OnKeyDown" />
            <Button Classes="accent" Content="Create" Click="CreateFolder_OnClick" />
            <Button Content="Cancel" Click="CancelCreateFolder_OnClick" />
          </StackPanel>

          <Border
              Grid.Row="3"
              Margin="8,6,8,0"
              Padding="10,6"
              Background="{DynamicResource Brush.Danger.Surface}"
              BorderBrush="{DynamicResource Brush.Danger}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Control}"
              IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
          </Border>

          <Grid Grid.Row="4" Margin="0,6,0,0" RowDefinitions="Auto,*" IsVisible="{Binding IsConnected}">
            <Border Classes="browser-header">
              <Grid ColumnDefinitions="2*,80,125,95,105">
                <Button AutomationProperties.Name="Sort by name" Classes="flat column" HorizontalContentAlignment="Left" Padding="20,2,8,2" Click="SortName_OnClick">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Name" />
                    <TextBlock Classes="sort" Text="{Binding NameSortGlyph}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" AutomationProperties.Name="Sort by size" Classes="flat column" HorizontalContentAlignment="Right" Click="SortSize_OnClick">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Size" />
                    <TextBlock Classes="sort" Text="{Binding SizeSortGlyph}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" AutomationProperties.Name="Sort by modified date" Classes="flat column" HorizontalContentAlignment="Left" Padding="12,2,8,2" Click="SortModified_OnClick">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Modified" />
                    <TextBlock Classes="sort" Text="{Binding ModifiedSortGlyph}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="3" AutomationProperties.Name="Sort by permissions" Classes="flat column" HorizontalContentAlignment="Left" Click="SortPermissions_OnClick">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Permissions" />
                    <TextBlock Classes="sort" Text="{Binding PermissionsSortGlyph}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="4" AutomationProperties.Name="Sort by owner" Classes="flat column" HorizontalContentAlignment="Left" Click="SortOwner_OnClick">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Owner" />
                    <TextBlock Classes="sort" Text="{Binding OwnerSortGlyph}" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <ListBox
                x:Name="FileList"
                Grid.Row="1"
                Classes="browser"
                Background="Transparent"
                SelectionMode="Multiple"
                ItemsSource="{Binding Items}"
                SelectionChanged="FileList_OnSelectionChanged"
                DoubleTapped="FileList_OnDoubleTapped"
                KeyDown="FileList_OnKeyDown"
                TextInput="FileList_OnTextInput"
                PointerPressed="FileList_OnPointerPressed"
                DragDrop.AllowDrop="True"
                DragDrop.DragOver="FileList_OnDragOver"
                DragDrop.DragLeave="FileList_OnDragLeave"
                DragDrop.Drop="FileList_OnDrop">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="viewModels:SftpItemViewModel">
                  <!-- The transparent background is what makes the gaps between the columns hit-testable, so
                       the context menu opens anywhere on the row rather than only over the file name. -->
                  <Grid ColumnDefinitions="2*,80,125,95,105" MinHeight="24" Background="Transparent">
                    <Grid ColumnDefinitions="20,*">
                      <!-- Two glyphs rather than one bound to a converter: a folder is the accent colour and a
                           file is not, and picking that with IsVisible keeps the choice in the view. -->
                      <PathIcon
                          Width="13"
                          Height="13"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Data="{DynamicResource Icon.Folder}"
                          Foreground="{DynamicResource Brush.Accent}"
                          IsVisible="{Binding IsDirectory}" />
                      <PathIcon
                          Width="13"
                          Height="13"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Data="{DynamicResource Icon.File}"
                          Foreground="{DynamicResource Brush.Text.Secondary}"
                          IsVisible="{Binding !IsDirectory}" />
                      <Grid Grid.Column="1">
                        <TextBlock VerticalAlignment="Center" IsVisible="{Binding !IsRenaming}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBox AutomationProperties.Name="Rename" IsVisible="{Binding IsRenaming}" Text="{Binding RenameText}" KeyDown="RenameEditor_OnKeyDown" />
                      </Grid>
                    </Grid>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding SizeText}" />
                    <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding Modified, StringFormat={}{0:g}}" />
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding Permissions}" />
                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding Owner}" TextTrimming="CharacterEllipsis" />
                    <Grid.ContextFlyout>
                      <MenuFlyout>
                        <MenuItem Header="Download" Click="Download_OnClick" />
                        <Separator />
                        <MenuItem Header="Edit remotely" Click="EditRemote_OnClick" />
                        <MenuItem Header="Stop remote editing" Click="StopRemoteEdit_OnClick" />
                        <Separator />
                        <MenuItem Header="Rename" Click="Rename_OnClick" />
                        <MenuItem Header="Delete…" Click="Delete_OnClick" />
                        <Separator />
                        <MenuItem Header="Properties" Click="Properties_OnClick" />
                        <MenuItem Header="Permissions…" Click="Permissions_OnClick" />
                        <MenuItem Header="Copy shell-safe path" Click="CopyPath_OnClick" />
                      </MenuFlyout>
                    </Grid.ContextFlyout>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <Border Grid.Row="4" Padding="40" IsVisible="{Binding !IsConnected}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
              <TextBlock FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Not connected" />
              <TextBlock
                  HorizontalAlignment="Center"
                  TextAlignment="Center"
                  TextWrapping="Wrap"
                  Foreground="{DynamicResource Brush.Text.Secondary}"
                  Text="{Binding NoConnectionMessage}" />
              <Button
                  Classes="accent"
                  Content="Connect"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding HasConnectionChoices}"
                  Command="{Binding ConnectSelectedCommand}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <GridSplitter
        Grid.Row="2"
        AutomationProperties.Name="Height of the transfer queue"
        AutomationProperties.HelpText="Use the up and down arrow keys to move the divider."
        Background="Transparent"
        ResizeDirection="Rows" />

    <storage:TransferQueuePane
        Grid.Row="3"
        DataContext="{Binding Transfers}"
        IsVisible="{Binding $parent[UserControl].((viewModels:SftpWorkspaceViewModel)DataContext).HasTransferQueue}" />

  </Grid>

    <!-- Status bar: every slot keeps its space whether or not it has content, so the pane above
         never reflows and the indicators never overlap each other. -->
    <Border
        Grid.Row="1"
        Height="32"
        Padding="12,0"
        Background="{DynamicResource Brush.Surface.1}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="150,*,Auto,Auto,Auto">
        <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center"
            IsVisible="{Binding IsBusyIndicatorVisible}">
          <ProgressBar Width="60" Height="4" MinWidth="60" MinHeight="4" IsIndeterminate="True" VerticalAlignment="Center" />
          <TextBlock Text="Loading…" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>
        <TextBlock
            Grid.Column="1"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
            Text="{Binding FeedbackMessage}"
            Foreground="{DynamicResource Brush.Text.Secondary}" />
        <TextBlock
            Grid.Column="2"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            IsVisible="{Binding HasActiveRemoteEdits}"
            Text="{Binding RemoteEditIndicator}"
            FontWeight="SemiBold" />
        <TextBlock
            Grid.Column="3"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            IsVisible="{Binding Local.DropTargetMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Text="{Binding Local.DropTargetMessage}"
            FontWeight="SemiBold" />
        <TextBlock
            Grid.Column="4"
            VerticalAlignment="Center"
            IsVisible="{Binding DropTargetMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Text="{Binding DropTargetMessage}"
            FontWeight="SemiBold" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
