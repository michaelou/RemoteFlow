<UserControl
    x:Class="RemoteFlow.UI.Views.Settings.PreferencesView"
    x:DataType="settingsViewModels:PreferencesViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settingsViewModels="using:RemoteFlow.UI.ViewModels.Settings">
  <ScrollViewer>
    <StackPanel Margin="8" MaxWidth="640" HorizontalAlignment="Left" Spacing="18">
      <StackPanel Spacing="5">
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Preferences" />
        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="How the app looks and how much of your history it keeps on screen." TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="5" IsEnabled="{Binding IsThemeAvailable}">
        <TextBlock FontWeight="SemiBold" Text="Appearance" />
        <ComboBox
            AutomationProperties.Name="Appearance"
            ItemsSource="{Binding Themes}"
            SelectedItem="{Binding SelectedTheme}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="settingsViewModels:AppThemeOption">
              <StackPanel Margin="2" Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding Description}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="The whole window changes as soon as you pick one." TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="5">
        <TextBlock FontWeight="SemiBold" Text="Recent connections" />
        <NumericUpDown
            AutomationProperties.Name="Recent connections"
            Minimum="0"
            Maximum="50"
            Increment="1"
            FormatString="0"
            Width="180"
            HorizontalAlignment="Left"
            Value="{Binding RecentLimit}" />
        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding RecentLimitDescription}" TextWrapping="Wrap" />
        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="The Connections page picks this up the next time you open it." TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
