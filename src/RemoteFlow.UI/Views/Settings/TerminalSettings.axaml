<UserControl
    x:Class="RemoteFlow.UI.Views.Settings.TerminalSettings"
    x:DataType="settingsViewModels:TerminalSettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settingsViewModels="using:RemoteFlow.UI.ViewModels.Settings"
    xmlns:terminal="using:SvcSystems.UI.Terminal">
  <!-- Two columns, because every control on this page changes something the preview shows: putting the
       preview beside the choices rather than under them means the swatch and the terminal it repaints are
       both on screen at once, whatever the window height. The cards group by question — how it looks, how
       it behaves, how it connects — rather than by control type. -->
  <ScrollViewer>
    <!-- Both columns are given a width rather than left to their content: the preview is a terminal, which
         has no opinion about how wide it should be, and a star column beside a fixed one in a
         left-aligned grid collapses it to nothing. 600 is eighty columns of the default font with room
         to spare, so the preview shows a real line rather than a clipped one. -->
    <Grid Margin="8" MaxWidth="1040" HorizontalAlignment="Left" ColumnDefinitions="380,6,600" RowDefinitions="Auto,Auto">
      <Border Grid.ColumnSpan="3" Classes="panel" Padding="16,14">
        <StackPanel Spacing="5">
          <TextBlock FontSize="28" FontWeight="SemiBold" Text="Terminal" />
          <TextBlock
              Foreground="{DynamicResource Brush.Text.Secondary}"
              Text="How every embedded terminal looks and behaves, with a live preview."
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="1" Margin="0,6,0,0" Spacing="6">
        <Border Classes="panel" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Classes="panel-title" Text="APPEARANCE" />
            <StackPanel>
              <TextBlock Classes="label" Text="Monospace font" />
              <ComboBox
                  AutomationProperties.Name="Monospace font"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding FontFamilies}"
                  SelectedItem="{Binding SelectedFontFamily}" />
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="label" Text="Font size" />
              <NumericUpDown
                  AutomationProperties.Name="Font size"
                  Minimum="6"
                  Maximum="72"
                  Value="{Binding FontSize}" />
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="label" Text="Colour scheme" />
              <ComboBox
                  AutomationProperties.Name="Colour scheme"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding ColorSchemes}"
                  SelectedItem="{Binding SelectedColorScheme}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="settingsViewModels:TerminalColorScheme">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border
                          Width="18"
                          Height="18"
                          Background="{Binding Background}"
                          BorderBrush="{Binding Foreground}"
                          BorderThickness="1"
                          CornerRadius="{DynamicResource Radius.Small}" />
                      <TextBlock Text="{Binding DisplayName}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Classes="panel-title" Text="BEHAVIOUR" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <StackPanel>
                <TextBlock Classes="label" Text="Cursor style" />
                <ComboBox
                    AutomationProperties.Name="Cursor style"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding CursorStyles}"
                    SelectedItem="{Binding CursorStyle}" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Classes="label" Text="Bell" />
                <ComboBox
                    AutomationProperties.Name="Bell"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding BellModes}"
                    SelectedItem="{Binding BellMode}" />
              </StackPanel>
            </Grid>

            <CheckBox Content="Blink the cursor" IsChecked="{Binding CursorBlink}" />

            <StackPanel>
              <TextBlock Classes="label" Text="Scrollback lines" />
              <NumericUpDown
                  AutomationProperties.Name="Scrollback lines"
                  Increment="1000"
                  Minimum="0"
                  Maximum="100000"
                  Value="{Binding Scrollback}" />
              <TextBlock Classes="hint" Text="{Binding ApplyNote}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Classes="panel-title" Text="SSH" />
            <StackPanel>
              <TextBlock Classes="label" Text="Transport" />
              <ComboBox
                  AutomationProperties.Name="SSH transport"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding SshTransports}"
                  SelectedItem="{Binding SelectedSshTransport}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="settingsViewModels:SshTransportOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="hint" Text="Transport changes apply to new SSH sessions only." />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock
            Foreground="{DynamicResource Brush.Danger}"
            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Margin="4,0,0,0"
            Text="{Binding ErrorMessage}"
            TextWrapping="Wrap" />
      </StackPanel>

      <!-- The preview takes whatever height the choices beside it end up needing, so the two columns end
           on the same line instead of leaving a card-shaped hole under a short one. -->
      <Border Grid.Row="1" Grid.Column="2" Classes="panel" Margin="0,6,0,0" Padding="16">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
          <TextBlock Classes="panel-title" Text="LIVE PREVIEW" />
          <Border
              Grid.Row="1"
              Background="{Binding PreviewBackground}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Control}"
              MinHeight="330"
              Padding="8">
            <terminal:TerminalControl
                Background="{Binding PreviewBackground}"
                FontFamily="{Binding SelectedFontFamily}"
                FontSize="{Binding FontSize}"
                IsHitTestVisible="False"
                Model="{Binding PreviewModel}" />
          </Border>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
