<UserControl
    x:Class="RemoteFlow.UI.Views.Settings.TerminalSettings"
    x:DataType="settingsViewModels:TerminalSettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settingsViewModels="using:RemoteFlow.UI.ViewModels.Settings"
    xmlns:terminal="using:SvcSystems.UI.Terminal">
  <ScrollViewer>
    <Grid Margin="28" RowDefinitions="Auto,Auto,Auto" MaxWidth="1040" HorizontalAlignment="Left">
      <StackPanel Spacing="5">
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Terminal appearance" />
        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Configure every embedded terminal with a live preview." />
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,24,0,0" ColumnDefinitions="360,24,600" RowDefinitions="Auto">
        <StackPanel Spacing="14">
          <StackPanel Spacing="5">
            <TextBlock FontWeight="SemiBold" Text="Monospace font" />
            <ComboBox AutomationProperties.Name="Monospace font" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding SelectedFontFamily}" />
          </StackPanel>

          <Grid ColumnDefinitions="*,16,*">
            <StackPanel Spacing="5">
              <TextBlock FontWeight="SemiBold" Text="Font size" />
              <NumericUpDown AutomationProperties.Name="Font size" Minimum="6" Maximum="72" Value="{Binding FontSize}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="5">
              <TextBlock FontWeight="SemiBold" Text="Scrollback lines" />
              <NumericUpDown AutomationProperties.Name="Scrollback lines" Minimum="0" Maximum="100000" Increment="1000" Value="{Binding Scrollback}" />
            </StackPanel>
          </Grid>

          <StackPanel Spacing="5">
            <TextBlock FontWeight="SemiBold" Text="Colour scheme" />
            <ComboBox AutomationProperties.Name="Colour scheme" ItemsSource="{Binding ColorSchemes}" SelectedItem="{Binding SelectedColorScheme}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="settingsViewModels:TerminalColorScheme">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="18" Height="18" CornerRadius="3" Background="{Binding Background}" BorderBrush="{Binding Foreground}" BorderThickness="1" />
                    <TextBlock Text="{Binding DisplayName}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <Grid ColumnDefinitions="*,16,*">
            <StackPanel Spacing="5">
              <TextBlock FontWeight="SemiBold" Text="Cursor style" />
              <ComboBox AutomationProperties.Name="Cursor style" ItemsSource="{Binding CursorStyles}" SelectedItem="{Binding CursorStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="5">
              <TextBlock FontWeight="SemiBold" Text="Bell" />
              <ComboBox AutomationProperties.Name="Bell" ItemsSource="{Binding BellModes}" SelectedItem="{Binding BellMode}" />
            </StackPanel>
          </Grid>

          <StackPanel Spacing="5">
            <TextBlock FontWeight="SemiBold" Text="SSH transport" />
            <ComboBox AutomationProperties.Name="SSH transport" ItemsSource="{Binding SshTransports}" SelectedItem="{Binding SelectedSshTransport}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="settingsViewModels:SshTransportOption">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Transport changes apply to new SSH sessions only." />
          </StackPanel>

          <CheckBox Content="Blink cursor" IsChecked="{Binding CursorBlink}" />
          <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding ApplyNote}" TextWrapping="Wrap" />
          <TextBlock Foreground="{DynamicResource Brush.Danger}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="Live preview" />
          <Border
              Background="{Binding PreviewBackground}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="1"
              CornerRadius="8"
              Height="330"
              Padding="8">
            <terminal:TerminalControl
                Background="{Binding PreviewBackground}"
                FontFamily="{Binding SelectedFontFamily}"
                FontSize="{Binding FontSize}"
                IsHitTestVisible="False"
                Model="{Binding PreviewModel}" />
          </Border>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="2" Margin="0,30,0,0" Spacing="12">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <StackPanel>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Shell profiles" />
            <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Arguments and environment variables use one entry per line." />
          </StackPanel>
          <Button Grid.Column="1" Command="{Binding AddShellProfileCommand}" Content="Add profile" />
          <Button Grid.Column="2" Command="{Binding SaveShellProfilesCommand}" Content="Save profiles" />
        </Grid>
        <Grid ColumnDefinitions="180,*" ColumnSpacing="12">
          <TextBlock FontWeight="SemiBold" Text="Default profile" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" AutomationProperties.Name="Default shell profile" ItemsSource="{Binding ShellProfiles}" SelectedItem="{Binding DefaultShellProfile}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="settingsViewModels:ShellProfileEditorViewModel">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <ItemsControl ItemsSource="{Binding ShellProfiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="settingsViewModels:ShellProfileEditorViewModel">
              <Border Background="{DynamicResource Brush.Surface.1}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="12">
                <Grid ColumnDefinitions="90,*,16,90,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                  <TextBlock Text="Name" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" AutomationProperties.Name="Profile name" Text="{Binding DisplayName}" />
                  <TextBlock Grid.Column="3" Text="Icon" VerticalAlignment="Center" />
                  <TextBox Grid.Column="4" AutomationProperties.Name="Profile icon" Text="{Binding Icon}" />

                  <TextBlock Grid.Row="1" Text="Executable" VerticalAlignment="Center" />
                  <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" AutomationProperties.Name="Profile executable" Text="{Binding ShellPath}" />

                  <TextBlock Grid.Row="2" Text="Working dir" VerticalAlignment="Center" />
                  <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" AutomationProperties.Name="Profile working directory" Text="{Binding WorkingDirectory}" />

                  <TextBlock Grid.Row="3" Text="Arguments" VerticalAlignment="Top" />
                  <TextBox Grid.Row="3" Grid.Column="1" AcceptsReturn="True" AutomationProperties.Name="Profile arguments, one per line" Height="74" Text="{Binding ArgumentsText}" TextWrapping="NoWrap" />
                  <TextBlock Grid.Row="3" Grid.Column="3" Text="Environment" VerticalAlignment="Top" />
                  <Grid Grid.Row="3" Grid.Column="4" RowDefinitions="*,Auto">
                    <TextBox AcceptsReturn="True" AutomationProperties.Name="Profile environment variables, one per line" Height="74" Text="{Binding EnvironmentText}" TextWrapping="NoWrap" />
                    <Button Grid.Row="1" Click="RemoveShellProfile_OnClick" Content="Remove" HorizontalAlignment="Right" Margin="0,8,0,0" />
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding ShellProfilesStatus}" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
