<UserControl
    x:Class="RemoteFlow.UI.Views.Terminal.TerminalWorkspace"
    x:DataType="terminalViewModels:TerminalsPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:terminal="using:SvcSystems.UI.Terminal"
    xmlns:terminalViews="using:RemoteFlow.UI.Views.Terminal"
    xmlns:terminalViewModels="using:RemoteFlow.UI.ViewModels.Terminal">
  <UserControl.Styles>
    <Style Selector="Border.session-tab:focus">
      <Setter Property="BorderThickness" Value="2,2,2,3" />
    </Style>
    <!-- The column picker's minimum height is taller than a button's, and the row is taller still because
         the page title beside it is two lines. Centring every control in the row is what puts the picker and
         the buttons on one line. -->
    <Style Selector="StackPanel#WorkspaceActions > :is(Control)">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Which tile has the keyboard decides what Close, Copy and Find act on, so in a grid it has to be
         legible at a glance. The tint alone is nearly invisible for a session with a grey accent. Both
         thicknesses are set here: a value set on the element itself would outrank the active one. -->
    <Style Selector="Border.session-tile">
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.session-tile.active">
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>
  <Grid Margin="8" RowDefinitions="Auto,Auto,*,Auto">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Terminal workspace" />
        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Independent local and remote sessions" />
      </StackPanel>
      <StackPanel x:Name="WorkspaceActions" Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <ToggleButton
            AutomationProperties.Name="Grid view"
            Content="Grid"
            IsChecked="{Binding IsGridLayout, Mode=TwoWay}"
            ToolTip.Tip="Show every session at once instead of one tab at a time" />
        <!-- MinHeight, not Height: the picker then measures to a button's height here without being pinned
             to a number that a font or theme change would leave stranded. -->
        <ComboBox
            AutomationProperties.Name="Maximum grid columns"
            IsVisible="{Binding IsGridLayout}"
            ItemsSource="{Binding GridColumnOptions}"
            MinHeight="30"
            SelectedItem="{Binding MaxGridColumns, Mode=TwoWay}"
            ToolTip.Tip="How many sessions a grid row holds before the next row starts"
            Width="62" />
        <Button Click="Shortcuts_OnClick" Content="Help" ToolTip.Tip="Keyboard shortcuts for copy, paste, find, and switching terminals" />
        <Button Command="{Binding SelectedTerminalSession.OpenFindCommand}" Content="Find" ToolTip.Tip="Find in scrollback (Ctrl+Shift+F)" />
        <Button
            Click="AddTab_OnClick"
            Content="+ New terminal"
            IsEnabled="{Binding !IsStarting}" />
        <Button AutomationProperties.Name="New terminal with profile" Content="▾" ToolTip.Tip="New terminal with profile">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <ItemsControl ItemsSource="{Binding ShellProfiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="terminalViewModels:ShellProfileMenuItemViewModel">
                    <Button
                        AutomationProperties.Name="{Binding DisplayName}"
                        Command="{Binding OpenCommand}"
                        HorizontalContentAlignment="Left"
                        MinWidth="220">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Icon}" />
                        <TextBlock Text="{Binding DisplayName}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
      <ScrollViewer
          x:Name="TabScroller"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Sessions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="terminalViewModels:IWorkspaceSessionViewModel">
              <!-- A tab is a control, not decoration: it takes keyboard focus, announces which session
                   and environment it is, and activates with Enter or Space. Without this the strip is
                   reachable only through the close buttons inside it. -->
              <Border
                  AutomationProperties.Name="{Binding TabAccessibleName}"
                  Background="{Binding TabBackgroundHex}"
                  BorderBrush="{Binding AccentColorHex}"
                  BorderThickness="0,0,0,3"
                  Classes="session-tab"
                  ClipToBounds="True"
                  CornerRadius="6,6,0,0"
                  Focusable="True"
                  KeyDown="Tab_OnKeyDown"
                  Margin="0,0,2,0"
                  MinWidth="150"
                  MaxWidth="240"
                  Padding="9,5,5,5"
                  PointerMoved="Tab_OnPointerMoved"
                  PointerPressed="Tab_OnPointerPressed"
                  PointerReleased="Tab_OnPointerReleased"
                  ToolTip.Tip="{Binding Title}">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Click="OpenSystemTerminal_OnClick" Header="Open in system terminal" IsVisible="{Binding CanOpenInSystemTerminal}" />
                  </ContextMenu>
                </Border.ContextMenu>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Border Background="{Binding AccentColorHex}" CornerRadius="3" Padding="4,1">
                      <TextBlock FontSize="10" FontWeight="Bold" Foreground="#0B0F14" Text="{Binding EnvironmentCue}" />
                    </Border>
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="4,1">
                      <TextBlock FontSize="10" FontWeight="Bold" Text="{Binding ProtocolCue}" />
                    </Border>
                  </StackPanel>
                  <!-- A star column (not a StackPanel) so the title is measured against the tab
                       width and actually trims instead of overflowing the close button. -->
                  <Grid Grid.Column="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                    <!-- The dot says "this session has ended". Its colour is not what carries that —
                         its presence is — but a reader needs the words. -->
                    <TextBlock
                        AutomationProperties.Name="Session ended"
                        IsVisible="{Binding IsEnded}"
                        Foreground="{DynamicResource Brush.Warning}"
                        Margin="0,0,5,0"
                        Text="●"
                        ToolTip.Tip="This session has ended"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding TabTitle}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        FontSize="10"
                        Foreground="{DynamicResource Brush.Text.Secondary}"
                        Text="{Binding StatusText}" />
                  </Grid>
                  <Button
                      Grid.Column="2"
                      AutomationProperties.Name="{Binding CloseTabAccessibleName}"
                      Click="CloseTab_OnClick"
                      Content="×"
                      FontSize="13"
                      Padding="6,1"
                      MinWidth="0"
                      VerticalAlignment="Center"
                      ToolTip.Tip="Close session (Ctrl+Shift+W)" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <Border
        Grid.Row="2"
        Background="{Binding SelectedSession.ChromeTintHex}"
        BorderBrush="{Binding SelectedSession.AccentColorHex}"
        BorderThickness="1"
        CornerRadius="0,0,6,6"
        PointerPressed="TerminalBorder_OnPointerPressed">
      <ItemsControl
          x:Name="SessionContent"
          ContainerClearing="SessionContent_OnContainerClearing"
          ContainerIndexChanged="SessionContent_OnContainerIndexChanged"
          ContainerPrepared="SessionContent_OnContainerPrepared"
          ItemsSource="{Binding Sessions}">
        <!-- One panel for both layouts. A tab is this grid with a single visible tile, and swapping the
             panel to change layout would rebuild the containers — which an embedded remote desktop, whose
             native window may only be hosted once, does not survive. -->
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <terminalViews:WorkspaceSessionTilePanel MaxColumns="{Binding MaxGridColumns}" TileSpacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="terminalViewModels:IWorkspaceSessionViewModel">
            <!-- The tile header is a row rather than an overlay, and the tile has no corner radius: native
                 remote desktop content draws above every Avalonia control and is not clipped by one. The
                 tint and the accent already differ for the selected session, so the tile the keyboard is in
                 is the one that looks lit. -->
            <Border
                Background="{Binding ChromeTintHex}"
                BorderBrush="{Binding AccentColorHex}"
                Classes="session-tile"
                Classes.active="{Binding IsActive}">
              <Grid RowDefinitions="Auto,*">
                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="7"
                    IsVisible="{Binding IsTiled}"
                    Margin="7,4,4,4">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Border Background="{Binding AccentColorHex}" CornerRadius="3" Padding="4,1">
                      <TextBlock FontSize="10" FontWeight="Bold" Foreground="#0B0F14" Text="{Binding EnvironmentCue}" />
                    </Border>
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="4,1">
                      <TextBlock FontSize="10" FontWeight="Bold" Text="{Binding ProtocolCue}" />
                    </Border>
                  </StackPanel>
                  <TextBlock
                      Grid.Column="1"
                      Text="{Binding TabTitle}"
                      TextTrimming="CharacterEllipsis"
                      ToolTip.Tip="{Binding Title}"
                      VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="10"
                        Foreground="{DynamicResource Brush.Text.Secondary}"
                        Text="{Binding StatusText}"
                        VerticalAlignment="Center" />
                    <Button
                        AutomationProperties.Name="{Binding CloseTabAccessibleName}"
                        Click="CloseTab_OnClick"
                        Content="×"
                        FontSize="13"
                        MinWidth="0"
                        Padding="6,1"
                        ToolTip.Tip="Close session (Ctrl+Shift+W)" />
                  </StackPanel>
                </Grid>
                <terminalViews:WorkspaceSessionContentHost
                    Grid.Row="1"
                    IsVisible="{Binding IsContentVisible}"
                    Session="{Binding}">
              <terminalViews:WorkspaceSessionContentHost.DataTemplates>
                <DataTemplate x:DataType="terminalViewModels:TerminalSessionViewModel">
            <Grid RowDefinitions="Auto,*">
              <Border
                  Background="{DynamicResource Brush.Surface.1}"
                  BorderBrush="{DynamicResource Brush.Border}"
                  BorderThickness="0,0,0,1"
                  IsVisible="{Binding IsFindOpen}"
                  Padding="8">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                  <TextBox
                      x:Name="FindTextBox"
                      AutomationProperties.Name="Find in scrollback"
                      PlaceholderText="Find in scrollback"
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                  <CheckBox Grid.Column="1" Content="Case" IsChecked="{Binding IsSearchCaseSensitive}" VerticalAlignment="Center" />
                  <CheckBox Grid.Column="2" Content="Regex" IsChecked="{Binding IsSearchRegex}" VerticalAlignment="Center" />
                  <Button Grid.Column="3" AutomationProperties.Name="Previous match" Command="{Binding FindPreviousCommand}" Content="↑" ToolTip.Tip="Previous match (Shift+Enter)" />
                  <Button Grid.Column="4" AutomationProperties.Name="Next match" Command="{Binding FindNextCommand}" Content="↓" ToolTip.Tip="Next match (Enter)" />
                  <Button Grid.Column="5" AutomationProperties.Name="Close find" Command="{Binding CloseFindCommand}" Content="×" ToolTip.Tip="Close find (Esc)" />
                </Grid>
              </Border>
              <Grid Grid.Row="1">
                <!-- Without an override this announces as an unlabelled custom control. It is a text
                     surface, and the name says which session a reader has landed in. -->
                <terminal:TerminalControl
                    AutomationProperties.ControlTypeOverride="Text"
                    AutomationProperties.Name="{Binding TerminalAccessibleName}"
                    AutomationProperties.HelpText="Terminal output and input. Ctrl+Shift+F searches the scrollback; F6 leaves the terminal."
                    Background="{Binding TerminalBackground}"
                    FontFamily="{Binding FontFamilyName}"
                    FontSize="{Binding TerminalFontSize}"
                    Model="{Binding Model}"
                    RightClickAction="None" />
                <Border
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{DynamicResource Brush.Surface.2}"
                    CornerRadius="4"
                    IsVisible="{Binding IsFindOpen}"
                    Margin="8"
                    Padding="7,4">
                  <StackPanel>
                    <TextBlock Text="{Binding SearchStatus}" />
                    <TextBlock Foreground="{DynamicResource Brush.Danger}" IsVisible="{Binding SearchError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding SearchError}" MaxWidth="420" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
                </DataTemplate>
              </terminalViews:WorkspaceSessionContentHost.DataTemplates>
                </terminalViews:WorkspaceSessionContentHost>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <StackPanel Grid.Row="3" Margin="0,8,0,0" Spacing="4">
      <TextBlock
          Foreground="{DynamicResource Brush.Warning}"
          IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
          Text="{Binding ErrorMessage}" />
      <TextBlock
          Foreground="{DynamicResource Brush.Text.Secondary}"
          Text="{Binding SelectedSession.EndedMessage}" />
      <Button
          HorizontalAlignment="Left"
          Command="{Binding SelectedSession.RetryCommand}"
          Content="{Binding SelectedSession.RecoveryActionLabel}"
          IsVisible="{Binding SelectedSession.IsEnded}" />
    </StackPanel>
  </Grid>
</UserControl>
