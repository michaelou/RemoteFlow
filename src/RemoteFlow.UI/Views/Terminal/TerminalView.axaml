<UserControl
    x:Class="RemoteFlow.UI.Views.Terminal.TerminalView"
    x:DataType="viewModels:TerminalsPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:terminal="using:SvcSystems.UI.Terminal"
    xmlns:viewModels="using:RemoteFlow.UI.ViewModels"
    Loaded="TerminalView_OnLoaded">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Local terminal" />
        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Local shell through the shared terminal channel" />
      </StackPanel>
      <Button
          Grid.Column="1"
          Click="Restart_OnClick"
          Content="Restart shell"
          IsEnabled="{Binding !IsStarting}" />
    </Grid>

    <Border
        Grid.Row="1"
        Background="#101418"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="1"
        CornerRadius="6"
        PointerPressed="TerminalBorder_OnPointerPressed">
      <terminal:TerminalControl
          x:Name="TerminalHost"
          FontFamily="Cascadia Mono, DejaVu Sans Mono, monospace"
          FontSize="13"
          Model="{Binding Session.Model}"
          RightClickAction="CopyOrPaste" />
    </Border>

    <StackPanel Grid.Row="2" Margin="0,8,0,0" Spacing="4">
      <TextBlock
          Foreground="{DynamicResource Brush.Warning}"
          IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
          Text="{Binding ErrorMessage}" />
      <TextBlock
          Foreground="{DynamicResource Brush.Text.Secondary}"
          Text="{Binding Session.EndedMessage}" />
    </StackPanel>
  </Grid>
</UserControl>
