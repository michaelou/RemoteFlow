<Window
    x:Class="RemoteFlow.UI.Views.MainWindow"
    x:DataType="viewModels:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:RemoteFlow.UI.Converters"
    xmlns:connectionViewModels="using:RemoteFlow.UI.ViewModels.Connections"
    xmlns:connectionViews="using:RemoteFlow.UI.Views.Connections"
    xmlns:backupViewModels="using:RemoteFlow.UI.ViewModels.Backup"
    xmlns:backupViews="using:RemoteFlow.UI.Views.Backup"
    xmlns:paletteViews="using:RemoteFlow.UI.Views.CommandPalette"
    xmlns:settingsViews="using:RemoteFlow.UI.Views.Settings"
    xmlns:securityViews="using:RemoteFlow.UI.Views.Security"
    xmlns:sftpViews="using:RemoteFlow.UI.Views.Sftp"
    xmlns:sftpViewModels="using:RemoteFlow.UI.ViewModels.Sftp"
    xmlns:storageViews="using:RemoteFlow.UI.Views.Storage"
    xmlns:storageViewModels="using:RemoteFlow.UI.ViewModels.Storage"
    xmlns:terminalViews="using:RemoteFlow.UI.Views.Terminal"
    xmlns:terminalViewModels="using:RemoteFlow.UI.ViewModels.Terminal"
    xmlns:transferViews="using:RemoteFlow.UI.Views.Transfers"
    xmlns:transferViewModels="using:RemoteFlow.UI.ViewModels.Transfers"
    xmlns:viewModels="using:RemoteFlow.UI.ViewModels"
    Title="RemoteFlow"
    Icon="/Assets/remoteflow.ico"
    Width="1200"
    Height="760"
    MinWidth="640"
    MinHeight="420"
    Background="{DynamicResource Brush.Surface.0}">
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type connectionViewModels:ConnectionsPageViewModel}" x:DataType="connectionViewModels:ConnectionsPageViewModel">
      <connectionViews:ConnectionsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type backupViewModels:BackupPageViewModel}" x:DataType="backupViewModels:BackupPageViewModel">
      <TabControl>
        <TabItem Header="Export">
          <backupViews:ExportView DataContext="{Binding Export}" />
        </TabItem>
        <TabItem Header="Import">
          <backupViews:ImportPreview DataContext="{Binding Import}" />
        </TabItem>
        <TabItem Header="Automatic">
          <backupViews:AutomaticBackupView DataContext="{Binding Automatic}" />
        </TabItem>
      </TabControl>
    </DataTemplate>
    <DataTemplate DataType="{x:Type terminalViewModels:TerminalsPageViewModel}" x:DataType="terminalViewModels:TerminalsPageViewModel">
      <terminalViews:TerminalWorkspace />
    </DataTemplate>
    <DataTemplate DataType="{x:Type sftpViewModels:SftpWorkspaceViewModel}" x:DataType="sftpViewModels:SftpWorkspaceViewModel">
      <sftpViews:SftpWorkspace />
    </DataTemplate>
    <DataTemplate DataType="{x:Type storageViewModels:StoragePageViewModel}" x:DataType="storageViewModels:StoragePageViewModel">
      <storageViews:StorageWorkspace />
    </DataTemplate>
    <DataTemplate DataType="{x:Type transferViewModels:TransfersPageViewModel}" x:DataType="transferViewModels:TransfersPageViewModel">
      <transferViews:TransfersView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:SettingsPageViewModel}" x:DataType="viewModels:SettingsPageViewModel">
      <TabControl>
        <TabItem Header="Preferences">
          <settingsViews:PreferencesView DataContext="{Binding Preferences}" />
        </TabItem>
        <TabItem Header="Terminal">
          <settingsViews:TerminalSettings DataContext="{Binding Terminal}" />
        </TabItem>
        <TabItem Header="Shell profiles">
          <settingsViews:ShellProfilesView DataContext="{Binding ShellProfiles}" />
        </TabItem>
        <TabItem Header="Remote desktop" IsVisible="{Binding Rdp.IsAvailable}">
          <settingsViews:RdpSettings DataContext="{Binding Rdp}" />
        </TabItem>
        <TabItem Header="Trusted keys">
          <securityViews:TrustedKeysView DataContext="{Binding Security}" />
        </TabItem>
        <TabItem Header="About">
          <settingsViews:AboutView DataContext="{Binding About}" />
        </TabItem>
      </TabControl>
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:PageViewModel}" x:DataType="viewModels:PageViewModel">
      <Grid Margin="32" RowDefinitions="Auto,Auto,*">
        <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding Title}" />
        <TextBlock Grid.Row="1" Margin="0,8,0,24" Foreground="{DynamicResource Brush.Text.Secondary}" Text="This page is ready for its feature content." />
        <TextBox
            Grid.Row="2"
            AutomationProperties.Name="Temporary page state"
            VerticalAlignment="Top"
            MaxWidth="560"
            HorizontalAlignment="Left"
            PlaceholderText="Temporary page state (kept while navigating)"
            Text="{Binding StateText}" />
      </Grid>
    </DataTemplate>
  </Window.DataTemplates>
  <Grid>
    <Grid ColumnDefinitions="220,*">
      <Grid RowDefinitions="*,Auto">
      <ListBox
        x:Name="NavigationList"
        AutomationProperties.Name="Main navigation"
        Classes="navigation"
        ItemsSource="{Binding NavigationItems}"
        KeyDown="NavigationList_OnKeyDown"
        SelectionChanged="NavigationList_OnSelectionChanged"
        SelectedIndex="0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="viewModels:NavigationItemViewModel">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                Data="{Binding IconKey, Converter={x:Static converters:ResourceKeyConverter.Instance}}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
      </ListBox>
        <Border
            Grid.Row="1"
            Height="32"
            Padding="12,0"
            Background="{DynamicResource Brush.Surface.1}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,1,0">
          <!-- Transfers finish while the user is somewhere else entirely, so this is a live region:
               the change is announced without stealing focus from whatever they are doing. -->
          <TextBlock
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="Transfer status"
              VerticalAlignment="Center"
              TextTrimming="CharacterEllipsis"
              Foreground="{DynamicResource Brush.Text.Secondary}"
              Text="{Binding Transfers.AggregateStatus, FallbackValue=No active transfers}" />
        </Border>
      </Grid>
      <!-- Named and focusable so that committing a navigation can put focus here: the screen reader
           then announces which page was opened, and a keyboard user lands in the page instead of
           tabbing through the whole sidebar to reach it. -->
      <Border Grid.Column="1" Background="{DynamicResource Brush.Surface.0}">
        <ContentControl
            x:Name="PageHost"
            AutomationProperties.Name="{Binding CurrentNavigationItem.Title, FallbackValue=Page}"
            Content="{Binding CurrentPage}"
            Focusable="True" />
      </Border>
    </Grid>

    <Border
        x:Name="PaletteOverlay"
        Background="#99000000"
        IsVisible="{Binding Palette.IsOpen}"
        PointerPressed="PaletteOverlay_OnPointerPressed"
        ZIndex="1000">
      <paletteViews:CommandPaletteView
          x:Name="CommandPalette"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Margin="24,96,24,24"
          CloseRequested="CommandPalette_OnCloseRequested"
          DataContext="{Binding Palette}" />
    </Border>
  </Grid>
</Window>
