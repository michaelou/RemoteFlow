<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Keyboard focus has to be findable at a glance on a near-black surface. The default adorner is a
       thin dotted outline in the foreground colour; this is a 2px accent ring at 7.4:1 or better against
       every surface, sitting just outside the control so it never overlaps the content it marks.
       Avalonia only shows the adorner for focus that arrived from the keyboard, so nothing changes for
       someone using a mouse. -->
  <Style Selector=":is(Control)">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border
            BorderBrush="{DynamicResource Brush.Focus}"
            BorderThickness="2"
            CornerRadius="{DynamicResource Radius.Focus}"
            Margin="-2" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <!-- Themed controls draw their own focus visual from their template rather than through the adorner
       above, and Fluent's is a one-pixel hairline that is easy to lose on a near-black surface. These
       repaint it in the accent, two pixels wide, for the controls a keyboard user actually lands on. -->
  <Style Selector=":is(Button):focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TreeViewItem:focus-visible /template/ Border#PART_LayoutRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Default}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.0}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>

  <!-- Everything that draws its own box takes Radius.Control, so a toolbar or a dialog full of mixed
       control types still reads as one set of shapes. The Fluent templates pass their own CornerRadius
       through to the part that paints, so setting it on the control is enough. -->
  <Style Selector=":is(Button)">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>
  <!-- The spinner's up and down buttons sit flush inside the text box they belong to. Rounding them
       would open a gap between the button and the box edge on every numeric field. -->
  <Style Selector="ButtonSpinner :is(Button)">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- A card: the surface a page's content sits on. One class rather than a background and a radius
       repeated in each view, so no two panels can drift apart. Padding stays with the view, which is the
       only thing that knows what it is holding. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.1}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Panel}" />
  </Style>

  <!-- The four pieces of type a form is built from. They started inside the connection editor and are
       here because every settings page wants the same ones: a card whose labels are a different size from
       the next card's reads as a different application. A label sits tight against its own control, so the
       gap between two fields is the section's spacing rather than the label's. -->
  <Style Selector="TextBlock.panel-title">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="Margin" Value="0,0,0,3" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="Margin" Value="0,3,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <!-- A button that carries no chrome until it is pointed at: column headers, breadcrumbs, and other
       places where a full button box would draw more attention than the action deserves. -->
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.2}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.2}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>

  <!-- The file and folder table on the Storage and SFTP pages. It is a dense listing rather than a list
       of cards: smaller type and a shorter row than the rest of the app, so a folder of a hundred entries
       can be scanned without scrolling. The metrics live here rather than in each view because the SFTP
       page puts a local pane and a remote listing side by side, and two tables that do not measure the
       same are two tables whose headings sit at different heights.

       The heading strip's left padding is the listing's padding plus a row's, so a heading and the cells
       it labels start on the same pixel: 10 = 4 + 6. -->
  <Style Selector="Border.browser-header">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,1" />
  </Style>
  <!-- The column headings are labels first and buttons second: they read as part of the table until they
       are pointed at, which is when the flat class gives them a box. MinHeight is cleared so the heading
       row is the height of its own padding rather than the height a form button wants to be. -->
  <Style Selector="Button.column">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="8,2" />
  </Style>
  <Style Selector="TextBlock.sort">
    <Setter Property="FontSize" Value="8" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.browser">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="4,2" />
  </Style>
  <!-- MinHeight is cleared for the same reason, and the corner comes down with the row: the panel radius
       on a 24-pixel row rounds away the ends of the selection instead of marking it. -->
  <Style Selector="ListBox.browser ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
  </Style>

  <!-- A button whose content is a single glyph. Equal padding on all four sides keeps it square
       instead of stretching into the width a word would need. -->
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="8" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector="ListBox.navigation">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector="ListBox.navigation ListBoxItem">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>
  <Style Selector="ListBox.navigation ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.2}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>
</Styles>
