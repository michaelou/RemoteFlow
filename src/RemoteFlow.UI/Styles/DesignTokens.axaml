<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="Color.Surface.0">#0B0F14</Color>
      <Color x:Key="Color.Surface.1">#121821</Color>
      <Color x:Key="Color.Surface.2">#1A2330</Color>
      <Color x:Key="Color.Border">#344052</Color>
      <Color x:Key="Color.Text.Primary">#F2F5F7</Color>
      <Color x:Key="Color.Text.Secondary">#B8C2CF</Color>
      <!-- 4.7:1 on Surface.2, the lightest surface disabled text ever sits on. The previous value read
           as disabled at 4.46:1 and failed the 4.5:1 floor by a hair. -->
      <Color x:Key="Color.Text.Disabled">#828D9C</Color>
      <Color x:Key="Color.Text.Muted">#8D97A5</Color>
      <Color x:Key="Color.Badge.Background">#A6D4F7</Color>
      <Color x:Key="Color.Badge.Text">#0B2032</Color>
      <!-- The chip at the end of a connection row writes its word in that environment's own colour, so the
           chip and the swatch beside the Environment picker are never two different greens. Only the fill
           behind it is a token of its own: a chip is a small block of solid colour repeated down the whole
           list, and at that size and that count the environment colour used as a fill turns the list into a
           christmas tree. Each is the environment's hue taken down to where its own colour clears 4.5:1 on
           it. -->
      <Color x:Key="Color.Badge.Prod.Background">#1B4630</Color>
      <Color x:Key="Color.Badge.Stage.Background">#4B3C14</Color>
      <Color x:Key="Color.Badge.Dev.Background">#512823</Color>
      <Color x:Key="Color.Accent">#6CB6FF</Color>
      <!-- The keyboard focus ring, deliberately not the accent: a blue ring on the accent-blue primary
           button is 2.1:1 and effectively invisible. Near-white clears 3:1 against every surface *and*
           against the accent button it can land on — 4.1:1 at worst, 17.6:1 at best. -->
      <Color x:Key="Color.Focus">#F2F5F7</Color>
      <Color x:Key="Color.Success">#5DE28C</Color>
      <Color x:Key="Color.Warning">#FFCA58</Color>
      <Color x:Key="Color.Danger">#FF7B72</Color>
      <!-- The inline error banner's fill. A token rather than the hard-coded translucent red the SFTP
           workspace still carries: opaque, so its contrast can actually be measured, and dark enough for
           primary text to clear 4.5:1 on it. -->
      <Color x:Key="Color.Danger.Surface">#391F26</Color>
      <!-- The five protocols, one hue each, so a glance down the explorer sorts a shell from a screen from
           a bucket without reading a word. Every one of these clears 3:1 against Surface.1 and Surface.2 —
           the floor for a graphic that carries meaning — and they are deliberately not the environment
           colours below: an amber bucket must not read as a staging badge. -->
      <Color x:Key="Color.Protocol.Ssh">#7EE787</Color>
      <Color x:Key="Color.Protocol.Sftp">#79C0FF</Color>
      <Color x:Key="Color.Protocol.Rdp">#D2A8FF</Color>
      <Color x:Key="Color.Protocol.S3">#FFA657</Color>
      <Color x:Key="Color.Protocol.AzureBlob">#56D4DD</Color>
      <!-- Green is the environment you are allowed to be in, red the one you are not: production reads as
           settled and development as the loud one, which is the way round this project wants them. Every
           surface that names an environment — the chip in the list, the swatch in the editor, the accent on
           a session tab — resolves to these three, so the same word is never two colours. -->
      <Color x:Key="Color.Environment.Dev">#FF7B72</Color>
      <Color x:Key="Color.Environment.Staging">#FFCA58</Color>
      <Color x:Key="Color.Environment.Production">#5DE28C</Color>
      <SolidColorBrush x:Key="Brush.Surface.0" Color="{DynamicResource Color.Surface.0}" />
      <SolidColorBrush x:Key="Brush.Surface.1" Color="{DynamicResource Color.Surface.1}" />
      <SolidColorBrush x:Key="Brush.Surface.2" Color="{DynamicResource Color.Surface.2}" />
      <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}" />
      <SolidColorBrush x:Key="Brush.Text.Primary" Color="{DynamicResource Color.Text.Primary}" />
      <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{DynamicResource Color.Text.Secondary}" />
      <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{DynamicResource Color.Text.Disabled}" />
      <SolidColorBrush x:Key="Brush.Text.Muted" Color="{DynamicResource Color.Text.Muted}" />
      <SolidColorBrush x:Key="Brush.Badge.Background" Color="{DynamicResource Color.Badge.Background}" />
      <SolidColorBrush x:Key="Brush.Badge.Text" Color="{DynamicResource Color.Badge.Text}" />
      <SolidColorBrush x:Key="Brush.Badge.Prod.Background" Color="{DynamicResource Color.Badge.Prod.Background}" />
      <SolidColorBrush x:Key="Brush.Badge.Stage.Background" Color="{DynamicResource Color.Badge.Stage.Background}" />
      <SolidColorBrush x:Key="Brush.Badge.Dev.Background" Color="{DynamicResource Color.Badge.Dev.Background}" />
      <!-- The chip's ink is the environment's own colour rather than a second token beside it, so the two
           cannot drift apart. -->
      <SolidColorBrush x:Key="Brush.Badge.Prod.Text" Color="{DynamicResource Color.Environment.Production}" />
      <SolidColorBrush x:Key="Brush.Badge.Stage.Text" Color="{DynamicResource Color.Environment.Staging}" />
      <SolidColorBrush x:Key="Brush.Badge.Dev.Text" Color="{DynamicResource Color.Environment.Dev}" />
      <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
      <SolidColorBrush x:Key="Brush.Focus" Color="{DynamicResource Color.Focus}" />
      <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Success}" />
      <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warning}" />
      <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Color.Danger}" />
      <SolidColorBrush x:Key="Brush.Danger.Surface" Color="{DynamicResource Color.Danger.Surface}" />
      <SolidColorBrush x:Key="Brush.Protocol.Ssh" Color="{DynamicResource Color.Protocol.Ssh}" />
      <SolidColorBrush x:Key="Brush.Protocol.Sftp" Color="{DynamicResource Color.Protocol.Sftp}" />
      <SolidColorBrush x:Key="Brush.Protocol.Rdp" Color="{DynamicResource Color.Protocol.Rdp}" />
      <SolidColorBrush x:Key="Brush.Protocol.S3" Color="{DynamicResource Color.Protocol.S3}" />
      <SolidColorBrush x:Key="Brush.Protocol.AzureBlob" Color="{DynamicResource Color.Protocol.AzureBlob}" />
      <SolidColorBrush x:Key="Brush.Environment.Dev" Color="{DynamicResource Color.Environment.Dev}" />
      <SolidColorBrush x:Key="Brush.Environment.Staging" Color="{DynamicResource Color.Environment.Staging}" />
      <SolidColorBrush x:Key="Brush.Environment.Production" Color="{DynamicResource Color.Environment.Production}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="Color.Surface.0">#F6F8FA</Color>
      <Color x:Key="Color.Surface.1">#FFFFFF</Color>
      <Color x:Key="Color.Surface.2">#EAEFF5</Color>
      <Color x:Key="Color.Border">#C4CCD6</Color>
      <Color x:Key="Color.Text.Primary">#17202B</Color>
      <Color x:Key="Color.Text.Secondary">#475569</Color>
      <Color x:Key="Color.Text.Disabled">#7B8794</Color>
      <Color x:Key="Color.Text.Muted">#6B7A8C</Color>
      <Color x:Key="Color.Badge.Background">#D7EBFB</Color>
      <Color x:Key="Color.Badge.Text">#134A75</Color>
      <!-- The same three, as tints rather than shades: on white a dark fill would be the loudest thing
           on the row. -->
      <Color x:Key="Color.Badge.Prod.Background">#D6F2E1</Color>
      <Color x:Key="Color.Badge.Stage.Background">#FAEDC8</Color>
      <Color x:Key="Color.Badge.Dev.Background">#FBE0DD</Color>
      <Color x:Key="Color.Accent">#0969DA</Color>
      <Color x:Key="Color.Focus">#0B1017</Color>
      <Color x:Key="Color.Success">#137333</Color>
      <Color x:Key="Color.Warning">#8A5A00</Color>
      <Color x:Key="Color.Danger">#B42318</Color>
      <Color x:Key="Color.Danger.Surface">#FDECEA</Color>
      <!-- The same five hues, darkened until each clears 3:1 on white rather than glowing on it. -->
      <Color x:Key="Color.Protocol.Ssh">#1A7F37</Color>
      <Color x:Key="Color.Protocol.Sftp">#0969DA</Color>
      <Color x:Key="Color.Protocol.Rdp">#8250DF</Color>
      <Color x:Key="Color.Protocol.S3">#BC4C00</Color>
      <Color x:Key="Color.Protocol.AzureBlob">#0F6D75</Color>
      <Color x:Key="Color.Environment.Dev">#B42318</Color>
      <Color x:Key="Color.Environment.Staging">#8A5A00</Color>
      <Color x:Key="Color.Environment.Production">#137333</Color>
      <SolidColorBrush x:Key="Brush.Surface.0" Color="{DynamicResource Color.Surface.0}" />
      <SolidColorBrush x:Key="Brush.Surface.1" Color="{DynamicResource Color.Surface.1}" />
      <SolidColorBrush x:Key="Brush.Surface.2" Color="{DynamicResource Color.Surface.2}" />
      <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}" />
      <SolidColorBrush x:Key="Brush.Text.Primary" Color="{DynamicResource Color.Text.Primary}" />
      <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{DynamicResource Color.Text.Secondary}" />
      <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{DynamicResource Color.Text.Disabled}" />
      <SolidColorBrush x:Key="Brush.Text.Muted" Color="{DynamicResource Color.Text.Muted}" />
      <SolidColorBrush x:Key="Brush.Badge.Background" Color="{DynamicResource Color.Badge.Background}" />
      <SolidColorBrush x:Key="Brush.Badge.Text" Color="{DynamicResource Color.Badge.Text}" />
      <SolidColorBrush x:Key="Brush.Badge.Prod.Background" Color="{DynamicResource Color.Badge.Prod.Background}" />
      <SolidColorBrush x:Key="Brush.Badge.Stage.Background" Color="{DynamicResource Color.Badge.Stage.Background}" />
      <SolidColorBrush x:Key="Brush.Badge.Dev.Background" Color="{DynamicResource Color.Badge.Dev.Background}" />
      <!-- The chip's ink is the environment's own colour rather than a second token beside it, so the two
           cannot drift apart. -->
      <SolidColorBrush x:Key="Brush.Badge.Prod.Text" Color="{DynamicResource Color.Environment.Production}" />
      <SolidColorBrush x:Key="Brush.Badge.Stage.Text" Color="{DynamicResource Color.Environment.Staging}" />
      <SolidColorBrush x:Key="Brush.Badge.Dev.Text" Color="{DynamicResource Color.Environment.Dev}" />
      <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
      <SolidColorBrush x:Key="Brush.Focus" Color="{DynamicResource Color.Focus}" />
      <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Success}" />
      <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warning}" />
      <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Color.Danger}" />
      <SolidColorBrush x:Key="Brush.Danger.Surface" Color="{DynamicResource Color.Danger.Surface}" />
      <SolidColorBrush x:Key="Brush.Protocol.Ssh" Color="{DynamicResource Color.Protocol.Ssh}" />
      <SolidColorBrush x:Key="Brush.Protocol.Sftp" Color="{DynamicResource Color.Protocol.Sftp}" />
      <SolidColorBrush x:Key="Brush.Protocol.Rdp" Color="{DynamicResource Color.Protocol.Rdp}" />
      <SolidColorBrush x:Key="Brush.Protocol.S3" Color="{DynamicResource Color.Protocol.S3}" />
      <SolidColorBrush x:Key="Brush.Protocol.AzureBlob" Color="{DynamicResource Color.Protocol.AzureBlob}" />
      <SolidColorBrush x:Key="Brush.Environment.Dev" Color="{DynamicResource Color.Environment.Dev}" />
      <SolidColorBrush x:Key="Brush.Environment.Staging" Color="{DynamicResource Color.Environment.Staging}" />
      <SolidColorBrush x:Key="Brush.Environment.Production" Color="{DynamicResource Color.Environment.Production}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <FontFamily x:Key="Font.Family.Default">fonts:Inter#Inter</FontFamily>
  <x:Double x:Key="Space.1">4</x:Double>
  <x:Double x:Key="Space.2">8</x:Double>
  <x:Double x:Key="Space.3">12</x:Double>
  <x:Double x:Key="Space.4">16</x:Double>
  <!-- Rounding is a token rather than a per-control decision, and the three sizes nest: a badge inside a
       control inside a panel keeps its corners concentric instead of fighting them. Radius.Focus is
       Radius.Control plus the two pixels the focus ring sits outside the control it marks, so the ring
       stays parallel to the edge it traces. -->
  <CornerRadius x:Key="Radius.Small">4</CornerRadius>
  <CornerRadius x:Key="Radius.Control">10</CornerRadius>
  <CornerRadius x:Key="Radius.Focus">12</CornerRadius>
  <CornerRadius x:Key="Radius.Panel">14</CornerRadius>
</ResourceDictionary>
