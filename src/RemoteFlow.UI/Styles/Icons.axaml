<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Every glyph is authored on a 16x16 grid so PathIcon can scale them uniformly. Outlines are
       cut with the even-odd rule (F0); solid glyphs stay on the default non-zero rule. -->
  <StreamGeometry x:Key="Icon.Connections">F0 M2,2.5H14V7H2Z M3.5,4H10V5.5H3.5Z M11.5,4H12.5V5.5H11.5Z M2,9H14V13.5H2Z M3.5,10.5H10V12H3.5Z M11.5,10.5H12.5V12H11.5Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Terminals">M2.6,3.2L7.4,8L2.6,12.8L1.2,11.4L4.6,8L1.2,4.6Z M8,11H14.5V13H8Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Transfers">M3.5,1.5H5.5V9.5H8L4.5,14.5L1,9.5H3.5Z M10.5,14.5H12.5V6.5H15L11.5,1.5L8,6.5H10.5Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Sftp">F0 M1.5,2.5H6L7.5,4.5H14.5V13.5H1.5Z M3,6V12H13V6Z M6.75,7H9.25V9H11L8,11.75L5,9H6.75Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Backup">F0 M1,2H15V6H1Z M2.5,3.5V4.5H13.5V3.5Z M2.5,7H13.5V14.5H2.5Z M4,8.5V13H12V8.5Z M6.25,9.75H9.75V11.25H6.25Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Settings">M1.5,3.25H14.5V4.25H1.5Z M2.55,3.75A2.2,2.2 0 1 0 6.95,3.75A2.2,2.2 0 1 0 2.55,3.75Z M1.5,7.5H14.5V8.5H1.5Z M8.05,8A2.2,2.2 0 1 0 12.45,8A2.2,2.2 0 1 0 8.05,8Z M1.5,11.75H14.5V12.75H1.5Z M4.3,12.25A2.2,2.2 0 1 0 8.7,12.25A2.2,2.2 0 1 0 4.3,12.25Z</StreamGeometry>

  <!-- The connection explorer's rows: what a node is. Folders reuse Icon.Folder, and an SSH or SFTP
       connection reuses the page glyph for the thing it opens. -->
  <StreamGeometry x:Key="Icon.Favorite">M8,1L9.7,5.65L14.66,5.84L10.76,8.9L12.11,13.66L8,10.9L3.89,13.66L5.24,8.9L1.34,5.84L6.3,5.65Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Recent">F0 M8,1.5A6.5,6.5 0 1 0 8,14.5A6.5,6.5 0 1 0 8,1.5Z M8,3A5,5 0 1 0 8,13A5,5 0 1 0 8,3Z M7.25,4.5H8.75V8.35H11.5V9.85H7.25Z</StreamGeometry>
  <!-- Object storage: a stack of drums, which is how both vendors' own consoles draw a bucket. -->
  <StreamGeometry x:Key="Icon.Storage">F0 M8,1.5C11.6,1.5 14,2.4 14,3.6V12.4C14,13.6 11.6,14.5 8,14.5C4.4,14.5 2,13.6 2,12.4V3.6C2,2.4 4.4,1.5 8,1.5Z M8,3C5.5,3 3.5,3.4 3.5,3.9C3.5,4.4 5.5,4.8 8,4.8C10.5,4.8 12.5,4.4 12.5,3.9C12.5,3.4 10.5,3 8,3Z M3.5,6.2V8.2C3.5,8.7 5.5,9.1 8,9.1C10.5,9.1 12.5,8.7 12.5,8.2V6.2C11.3,6.6 9.7,6.8 8,6.8C6.3,6.8 4.7,6.6 3.5,6.2Z M3.5,10.5V12.2C3.5,12.7 5.5,13.1 8,13.1C10.5,13.1 12.5,12.7 12.5,12.2V10.5C11.3,10.9 9.7,11.1 8,11.1C6.3,11.1 4.7,10.9 3.5,10.5Z</StreamGeometry>
  <!-- Object storage again, but the other vendor's: a cloud, so an S3 bucket and an Azure container are
       told apart by shape and not only by colour. Authored as one closed outline — three overlapping
       circles would need a winding rule the rest of this file does not use. -->
  <StreamGeometry x:Key="Icon.Cloud">M3.4,11.8A2.6,2.6 0 0 1 4.3,6.75A4,4 0 0 1 11.6,7.9A2.1,2.1 0 0 1 12.6,11.8Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.RemoteDesktop">F0 M1.5,2.5H14.5V11.5H1.5Z M3,4V10H13V4Z M6.9,11.5H9.1V13H12V14.5H4V13H6.9Z</StreamGeometry>

  <!-- The explorer's own toolbar. Clear recent is the Recent clock with a cross beside it rather than a
       cross struck through it: an even-odd glyph punches a hole wherever two shapes overlap, so the two
       are drawn side by side and kept apart. -->
  <StreamGeometry x:Key="Icon.ClearRecent">F0 M6,1A5,5 0 1 0 6,11A5,5 0 1 0 6,1Z M6,2.2A3.8,3.8 0 1 0 6,9.8A3.8,3.8 0 1 0 6,2.2Z M5.4,3.2H6.6V6.1H8.7V7.3H5.4Z M10.85,10.15L13,12.3L15.15,10.15L15.85,10.85L13.7,13L15.85,15.15L15.15,15.85L13,13.7L10.85,15.85L10.15,15.15L12.3,13L10.15,10.85Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.CollapseAll">M8,2L13.5,7.5L11.9,9.1L8,5.2L4.1,9.1L2.5,7.5Z M8,7.4L13.5,12.9L11.9,14.5L8,10.6L4.1,14.5L2.5,12.9Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.ExpandAll">M8,14L13.5,8.5L11.9,6.9L8,10.8L4.1,6.9L2.5,8.5Z M8,8.6L13.5,3.1L11.9,1.5L8,5.4L4.1,1.5L2.5,3.1Z</StreamGeometry>
  <!-- The row's second line, shown and hidden: a whole rule under the name, or the dashes left when it
       is gone. The pair reads as one control changing state rather than as two unrelated glyphs. -->
  <StreamGeometry x:Key="Icon.DetailLine">M2,4H14V6.2H2Z M2,9.4H9.5V11.6H2Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.DetailLineOff">M2,4H14V6.2H2Z M2,9.4H3.9V11.6H2Z M5.2,9.4H7.1V11.6H5.2Z M8.4,9.4H10.3V11.6H8.4Z</StreamGeometry>

  <StreamGeometry x:Key="Icon.Edit">M2,10.6L10.6,2L14,5.4L5.4,14L1.2,14.8Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Duplicate">F0 M5,1.5H14.5V11H12.5V3.5H5Z M1.5,5H11V14.5H1.5Z M3,6.5V13H9.5V6.5Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Delete">F0 M6,1.5H10V3H15V4.5H1V3H6Z M3,6H13V15H3Z M4.5,7.5V13.5H11.5V7.5Z M6.5,8.5H7.5V12.5H6.5Z M8.5,8.5H9.5V12.5H8.5Z</StreamGeometry>

  <!-- The file browser: what a row is, and what can be done to the folder being shown. -->
  <StreamGeometry x:Key="Icon.Folder">M1.5,3H6L7.6,4.9H14.5V13H1.5Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.File">F0 M3.5,1.5H9.4L12.5,4.6V14.5H3.5Z M5,3V13H11V6.1H8.6V3Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.NewFolder">F0 M1.5,3H6L7.6,4.9H14.5V13H1.5Z M3,6.4V11.5H13V6.4Z M7.25,7.15H8.75V8.4H10V9.9H8.75V11.15H7.25V9.9H6V8.4H7.25Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Permissions">F0 M8,1.5A3.2,3.2 0 0 1 11.2,4.7V7H9.7V4.7A1.7,1.7 0 0 0 6.3,4.7V7H4.8V4.7A3.2,3.2 0 0 1 8,1.5Z M3.5,7H12.5V14.5H3.5Z M5,8.5V13H11V8.5Z M7.25,9.5H8.75V12H7.25Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Upload">M8,1.5L11.8,5.9H9.2V11H6.8V5.9H4.2Z M2.5,12.5H13.5V14.5H2.5Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Download">M6.8,1.5H9.2V6.6H11.8L8,11L4.2,6.6H6.8Z M2.5,12.5H13.5V14.5H2.5Z</StreamGeometry>

  <!-- Moving around, and stopping. -->
  <!-- Refresh is a 270° ring travelling clockwise from the top, with the head at the end of the sweep
       pointing into the gap it left. The head has to overhang the ring on both sides or it reads as a nub. -->
  <StreamGeometry x:Key="Icon.Refresh">M8,2.4A5.6,5.6 0 1 1 2.4,8H4.4A3.6,3.6 0 1 0 8,4.4Z M0.8,8H6L3.4,3.6Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Back">M7.2,2.4L1.6,8L7.2,13.6V9.2H13.5V6.8H7.2Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Forward">M8.8,2.4L14.4,8L8.8,13.6V9.2H2.5V6.8H8.8Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Up">M8,1.6L13.6,7.2H9.2V13.5H6.8V7.2H2.4Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Cancel">M3.7,2.3L8,6.6L12.3,2.3L13.7,3.7L9.4,8L13.7,12.3L12.3,13.7L8,9.4L3.7,13.7L2.3,12.3L6.6,8L2.3,3.7Z</StreamGeometry>
</ResourceDictionary>
