<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>../RemoteFlow.UI/Assets/remoteflow.ico</ApplicationIcon>
    <!-- What a user sees and types: RemoteFlow.exe, not RemoteFlow.Desktop.exe. The project keeps its
         name; only the produced binary is renamed. -->
    <AssemblyName>RemoteFlow</AssemblyName>
    <RootNamespace>RemoteFlow.Desktop</RootNamespace>
    <!-- Checks every resolved package against build/licenses/allowed-licenses.txt and the generated
         manifest. This is the project whose graph the notices are generated from. -->
    <VerifyPackageLicenses>true</VerifyPackageLicenses>
  </PropertyGroup>

  <!-- Explorer's Details tab and the installer both read these. Version and FileVersion come from MinVer;
       nothing here restates a version number. -->
  <PropertyGroup>
    <Product>RemoteFlow</Product>
    <AssemblyTitle>RemoteFlow</AssemblyTitle>
    <Company>michaelou</Company>
    <Authors>michaelou</Authors>
    <Copyright>Copyright (c) 2026 michaelou</Copyright>
    <Description>SSH, SFTP, and terminal client for managing remote machines.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS_RDP</DefineConstants>
  </PropertyGroup>

  <!-- Shipping shape: self-contained per architecture, so the zip runs on a machine with no .NET
       installed. Trimming and AOT stay off — EF Core and Avalonia's XAML loader both use reflection that
       a trimmer cannot see (ADR 0003, and the properties set repository-wide). -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>portable</DebugType>
    <!-- The published tree is zipped and shipped; symbols belong with the build, not the download. -->
    <DebugSymbols Condition="'$(RuntimeIdentifier)' != ''">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RemoteFlow.Application/RemoteFlow.Application.csproj" />
    <ProjectReference Include="../RemoteFlow.Infrastructure/RemoteFlow.Infrastructure.csproj" />
    <ProjectReference Include="../RemoteFlow.Persistence/RemoteFlow.Persistence.csproj" />
    <ProjectReference Include="../RemoteFlow.UI/RemoteFlow.UI.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <!-- Keep this as a build-order dependency rather than a compile reference. NuGet correctly rejects a
         net10.0 -> net10.0-windows project reference, so the Windows-only assembly reference below is the
         explicit host-gated bridge while this item ensures the dependency is built first. -->
    <ProjectReference Include="../RemoteFlow.Rdp.Windows/RemoteFlow.Rdp.Windows.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <Reference Include="RemoteFlow.Rdp.Windows">
      <HintPath Condition="'$(RuntimeIdentifier)' == ''">../RemoteFlow.Rdp.Windows/bin/$(Configuration)/net10.0-windows/RemoteFlow.Rdp.Windows.dll</HintPath>
      <HintPath Condition="'$(RuntimeIdentifier)' != ''">../RemoteFlow.Rdp.Windows/bin/$(Configuration)/net10.0-windows/$(RuntimeIdentifier)/RemoteFlow.Rdp.Windows.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>
