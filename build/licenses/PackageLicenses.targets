<Project>
  <!--
    Fails the build when a package's licence is not one RemoteFlow has agreed to ship, or when a package
    reached the build without reaching build/licenses/package-licenses.txt.

    RemoteFlow is MIT. A copyleft dependency arriving transitively — nobody adds one on purpose — would
    otherwise be discovered by whoever reads the licences of a released binary, which is far too late.
    This turns that into a build error at the moment the dependency appears.

    Two checks, both cheap string work over files generated by scripts/generate-notices.ps1:

      1. Every entry in the manifest carries a licence listed in allowed-licenses.txt.
      2. Every package this build actually resolved appears in the manifest.

    The second is what keeps the first honest: without it, a new dependency would simply be absent from
    the manifest and checked against nothing.

    Imported by Directory.Build.targets for the desktop application only. It is the project that ships,
    its package graph is the superset of every other project's, and the manifest is generated from it.
  -->

  <PropertyGroup>
    <_LicensePolicyDirectory>$(MSBuildThisFileDirectory)</_LicensePolicyDirectory>
    <_AllowedLicensesFile>$(_LicensePolicyDirectory)allowed-licenses.txt</_AllowedLicensesFile>
    <_PackageLicensesFile>$(_LicensePolicyDirectory)package-licenses.txt</_PackageLicensesFile>
  </PropertyGroup>

  <Target Name="VerifyPackageLicenses"
          AfterTargets="ResolvePackageAssets"
          BeforeTargets="CoreCompile">

    <Error Condition="!Exists('$(_AllowedLicensesFile)')"
           Text="The licence allow-list is missing: $(_AllowedLicensesFile)" />
    <Error Condition="!Exists('$(_PackageLicensesFile)')"
           Text="The package licence manifest is missing: $(_PackageLicensesFile). Generate it with: pwsh ./scripts/generate-notices.ps1" />

    <ReadLinesFromFile File="$(_AllowedLicensesFile)">
      <Output TaskParameter="Lines" ItemName="_AllowedLicenseLine" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_PackageLicensesFile)">
      <Output TaskParameter="Lines" ItemName="_PackageLicenseLine" />
    </ReadLinesFromFile>

    <ItemGroup>
      <!-- Both files carry # comments for the humans who maintain them. -->
      <_AllowedLicense Include="@(_AllowedLicenseLine)"
                       Condition="'%(Identity)' != '' and !$([System.String]::Copy('%(Identity)').StartsWith('#'))" />

      <!-- id|version|spdx. Regex rather than Split because MSBuild property functions cannot index the
           array a Split returns. -->
      <_ManifestEntry Include="@(_PackageLicenseLine)"
                      Condition="'%(Identity)' != '' and !$([System.String]::Copy('%(Identity)').StartsWith('#'))">
        <PackageId>$([System.Text.RegularExpressions.Regex]::Replace('%(Identity)', '\|.*$', ''))</PackageId>
        <License>$([System.Text.RegularExpressions.Regex]::Replace('%(Identity)', '^[^|]*\|[^|]*\|', ''))</License>
      </_ManifestEntry>
    </ItemGroup>

    <ItemGroup>
      <!-- A separate pass: metadata cannot be derived from metadata declared on the same item. -->
      <_ManifestEntryKeyed Include="@(_ManifestEntry)">
        <PackageIdLower>$([System.String]::Copy('%(PackageId)').ToLowerInvariant())</PackageIdLower>
      </_ManifestEntryKeyed>
    </ItemGroup>

    <PropertyGroup>
      <!-- Delimited on both ends so Contains('|MIT|') cannot match a longer identifier that merely starts
           with the same letters. -->
      <_AllowedLicenseList>|@(_AllowedLicense, '|')|</_AllowedLicenseList>
      <_ManifestIdList>|@(_ManifestEntryKeyed->'%(PackageIdLower)', '|')|</_ManifestIdList>
    </PropertyGroup>

    <!-- Check 1: nothing in the manifest is licensed outside the allow-list. -->
    <ItemGroup>
      <_DisallowedLicence Include="@(_ManifestEntryKeyed)"
                          Condition="!$(_AllowedLicenseList.Contains('|%(License)|'))" />
    </ItemGroup>

    <Error Condition="'@(_DisallowedLicence)' != ''"
           Code="RF0001"
           Text="Unapproved package licence: @(_DisallowedLicence->'%(PackageId) is %(License)', '; '). RemoteFlow ships as MIT and only accepts $(_AllowedLicenseList.Trim('|').Replace('|', ', ')). Either drop the dependency, or accept the licence deliberately by adding it to build/licenses/allowed-licenses.txt together with build/licenses/texts/&lt;identifier&gt;.txt." />

    <!-- Check 2: nothing this build resolved is absent from the manifest. Packages are named by whichever
         assets they contribute, so the three item groups together cover managed, native, and copy-local. -->
    <ItemGroup>
      <_ResolvedPackageId Include="@(ResolvedCompileFileDefinitions->'%(NuGetPackageId)')" />
      <_ResolvedPackageId Include="@(RuntimeCopyLocalItems->'%(NuGetPackageId)')" />
      <_ResolvedPackageId Include="@(NativeCopyLocalItems->'%(NuGetPackageId)')" />
    </ItemGroup>

    <RemoveDuplicates Inputs="@(_ResolvedPackageId)">
      <Output TaskParameter="Filtered" ItemName="_ResolvedPackage" />
    </RemoveDuplicates>

    <ItemGroup>
      <_UnlistedPackage Include="@(_ResolvedPackage)"
                        Condition="'%(Identity)' != '' and !$(_ManifestIdList.Contains('|$([System.String]::Copy('%(Identity)').ToLowerInvariant())|'))" />
    </ItemGroup>

    <Error Condition="'@(_UnlistedPackage)' != ''"
           Code="RF0002"
           Text="Package not covered by the third-party notices: @(_UnlistedPackage, '; '). The dependency graph changed; regenerate the notices and commit them: pwsh ./scripts/generate-notices.ps1" />

    <Message Importance="normal"
             Text="Package licences verified: @(_ManifestEntryKeyed->Count()) manifest entries, @(_ResolvedPackage->Count()) resolved packages." />
  </Target>
</Project>
