#!/bin/sh
set -eu

name="$1"
source="/opt/remoteflow/host_keys/$name"

test -f "$source"
test -f "$source.pub"
cp "$source" /etc/ssh/ssh_host_ed25519_key
cp "$source.pub" /etc/ssh/ssh_host_ed25519_key.pub
chmod 0600 /etc/ssh/ssh_host_ed25519_key
chmod 0644 /etc/ssh/ssh_host_ed25519_key.pub

if [ "${2:-}" != "--no-reload" ]; then
    kill -HUP "$(cat /run/sshd.pid)"
fi
