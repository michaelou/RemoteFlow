<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../../src/RemoteFlow.UI/RemoteFlow.UI.csproj" />
    <!-- The composition test builds the container the desktop host builds, which needs the two
         implementation projects. DependencyDirectionTests only guards the src assemblies, so a test
         project referencing them proves nothing wrong about the layering. -->
    <ProjectReference Include="../../src/RemoteFlow.Infrastructure/RemoteFlow.Infrastructure.csproj" />
    <ProjectReference Include="../../src/RemoteFlow.Persistence/RemoteFlow.Persistence.csproj" />
    <ProjectReference Include="../RemoteFlow.TestSupport/RemoteFlow.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Copied to the output directory because the in-process runner reads it from beside the test binary.
         Without this the file is silently inert and the collections run in parallel again. -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
